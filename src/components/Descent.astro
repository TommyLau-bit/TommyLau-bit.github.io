              {r.kind === 'P' && [0, 1, 2, 3, 4, 5].map((k) => (
                <g>
                  <rect class="s-bay" x={315 + k * 29} y={r.y + 2} width="26" height={r.h - 4} rx="1" />
                  <circle class="s-thin" cx={321 + k * 29} cy={r.y + r.h / 2} r="3" />
                </g>
              ))}
