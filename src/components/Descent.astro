      <p>{net.what}</p>
      <p class="binds"><strong>What binds.</strong> {net.constraint}</p>
      <ul class="reads">{reads(net.pieces.slice(0, 3)).map((r) => <li><a href={r.href}>{r.title}</a></li>)}</ul>
    </div></div>

