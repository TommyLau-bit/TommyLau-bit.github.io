  .draw { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.4s ease; }
  .descent:not(.dj) .draw, [data-at].on .draw { stroke-dashoffset: 0; }
  .tray { transform-box: fill-box; transition: opacity .45s ease var(--d, 0ms), transform .45s ease var(--d, 0ms); }
