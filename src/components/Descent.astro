  .descent .scene.leaving .lbl { opacity: 0; transition: opacity .2s; }

  /* html panels */
  .panel { font-family: var(--sans); background: var(--bg-elev); border: 1px solid var(--rule); border-radius: 10px; padding: 1.4rem 1.5rem; }
  .panel-h { font-weight: 700; font-size: 1.05rem; margin: 0 0 1rem; color: var(--ink); }
  .panel-foot { margin: 0.9rem 0 0; font-size: 0.75rem; color: var(--ink-3); pointer-events: auto; }
  .rrow { display: grid; grid-template-columns: 1fr 1.1fr; gap: 0.2rem 1.2rem; padding: 0.75rem 0; border-top: 1px solid var(--rule); }
  .rname { margin: 0; font-size: 0.9rem; font-weight: 600; color: var(--ink); grid-row: span 2; }
