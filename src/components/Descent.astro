---
// The descent: the stack told as one scroll, from a high-voltage line to the rack the power feeds.
// Text (what happens, what binds, the pieces) is read from src/data/stack.ts; the
// drawings are hand-made per stop. A new layer in stack.ts appears in the closing
// funnel on its own, but needs its own drawing to get a stop of its own.
import { getCollection } from 'astro:content';
import { STACK } from '../data/stack';

const posts = await getCollection('journal', ({ data }) => !data.draft);
const byId = Object.fromEntries(posts.map((p) => [p.id, p]));
const L = (id: string) => STACK.find((l) => l.id === id)!;
const reads = (ids: string[]) => ids.map((id) => byId[id]).filter(Boolean).map((p) => ({ href: `/journal/${p.id}/`, title: p.data.title }));
// a section of a deep piece, by the anchor of the piece merged into it (CLAUDE.md, "Merging keeps the record")
const at = (id: string, anchor: string, title: string) => (byId[id] ? [{ href: `/journal/${id}/#${anchor}`, title }] : []);
const grid = L('grid'), equip = L('equipment'), onsite = L('onsite'), nuke = L('nuclear'), dist = L('distribution'), cool = L('cooling');
const funnel = STACK.map((l) => ({ ...l, n: l.pieces.filter((id) => byId[id]).length })).filter((l) => l.n > 0).map((l, i) => ({ ...l, w: 100 - i * 8 }));

// ── 1 · grid ──
const PY = [30, 170, 310];
const att = [[2, 330, 16], [58, 330, 16], [50, 312, 14], [30, 284, 10]];
const spans: string[] = [];
att.forEach(([dx, y, sag]) => {
  spans.push(`M-6 ${y + 6} Q ${(PY[0] + dx - 6) / 2} ${y + 10} ${PY[0] + dx} ${y}`);
  for (let i = 0; i < PY.length - 1; i++) { const a = PY[i] + dx, b = PY[i + 1] + dx; spans.push(`M${a} ${y} Q ${(a + b) / 2} ${y + sag} ${b} ${y}`); }
});
const ends: [number, number][] = [[446, 354], [480, 354], [466, 354], [486, 340]];
att.forEach(([dx, y, sag], k) => { const a = PY[2] + dx, [ex, ey] = ends[k]; spans.push(`M${a} ${y} Q ${(a + ex) / 2} ${Math.max(y, ey) + sag * 0.6} ${ex} ${ey}`); });

// ── 3 · hall ──
const hallRacks = [0, 1, 2, 3, 4, 5].map((k) => 280 + k * 70);

// ── 4 · rack ──
type Row = { kind: 'P' | 'C' | 'S'; y: number; h: number };
const order: Row['kind'][] = ['P', 'P', ...Array(10).fill('C'), ...Array(9).fill('S'), ...Array(8).fill('C'), 'P', 'P'];
let ry = 52;
const rows: Row[] = order.map((kind) => { const h = kind === 'S' ? 10 : 14; const r = { kind, y: ry, h }; ry += h + 2; return r; });
const computeRows = rows.filter((r) => r.kind === 'C');
const focusTray = computeRows[3];

const n = (i: number) => String(i).padStart(2, '0');
