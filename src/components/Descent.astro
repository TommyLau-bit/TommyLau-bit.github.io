  .coldplate { fill: color-mix(in srgb, var(--ink-3) 30%, transparent); stroke: var(--ink-2); stroke-width: 1.2; }
  .minipkg rect { vector-effect: non-scaling-stroke; }

  .substrate { fill: color-mix(in srgb, var(--pcb) 14%, var(--bg-elev)); stroke: var(--ink-3); stroke-width: 1.2; }
  .cap { fill: color-mix(in srgb, var(--copper) 55%, var(--bg)); }
  .interposer { fill: color-mix(in srgb, var(--ink) 7%, var(--bg)); stroke: var(--ink-3); }
  .s-mesh { stroke: var(--ink-3); stroke-width: 0.35; opacity: 0.45; }
  .die { fill: color-mix(in srgb, var(--accent-2) 22%, var(--bg)); stroke: var(--accent-2); stroke-width: 1.4; }
  .blk { fill: var(--accent-2); }
  .bridge { fill: var(--accent-2); opacity: 0.9; }
  .hbm { fill: color-mix(in srgb, var(--ink) 18%, var(--bg)); stroke: var(--ink-2); stroke-width: 1.1; }
  .hbm-in { fill: none; stroke: var(--ink-3); stroke-width: 0.7; }
  .hbm-layer { fill: color-mix(in srgb, var(--ink) 18%, var(--bg)); stroke: var(--ink-2); stroke-width: 0.8; }
  .tsv { stroke: var(--accent-2); stroke-width: 1.2; stroke-dasharray: 2 2; }
  .leader { fill: none; stroke: var(--ink-3); stroke-width: .8; stroke-dasharray: 2 2; }

  .laser { stroke: var(--bad); stroke-width: 2.4; }
  .tin { fill: var(--ink-2); animation: drip 1.2s linear infinite; animation-delay: calc(var(--k) * -0.3s); }
  @keyframes drip { from { transform: translateY(-8px); opacity: 0; } 20% { opacity: 1; } to { transform: translateY(16px); opacity: .4; } }
  .glow-0 { stop-color: var(--euv); stop-opacity: .9; }
  .glow-1 { stop-color: var(--euv); stop-opacity: 0; }
  .plasma { fill: url(#d-glow); animation: pulse 1.2s ease-in-out infinite; }
  .plasma-core { fill: var(--euv); }
  .euv-cone { fill: var(--euv); opacity: .12; }
  .beam { fill: none; stroke: var(--euv); stroke-width: 2.2; stroke-linejoin: round; }
  .mirror { fill: var(--bg-elev); stroke: var(--ink); stroke-width: 1.4; }
