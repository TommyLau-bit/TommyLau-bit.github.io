---
// The descent: the stack told as one scroll, from a high-voltage line to the die.
// Text (what happens, what binds, the pieces) is read from src/data/stack.ts; the
// drawings are hand-made per stop. A new layer in stack.ts appears in the closing
// funnel on its own, but needs its own drawing to get a stop of its own.
import { getCollection } from 'astro:content';
import { STACK } from '../data/stack';

const posts = await getCollection('journal', ({ data }) => !data.draft);
const byId = Object.fromEntries(posts.map((p) => [p.id, p]));
const L = (id: string) => STACK.find((l) => l.id === id)!;
const reads = (ids: string[]) => ids.map((id) => byId[id]).filter(Boolean).map((p) => ({ href: `/journal/${p.id}/`, title: p.data.title }));
const grid = L('grid'), onsite = L('onsite'), dist = L('distribution'), cool = L('cooling'), net = L('network'), mem = L('memory'), chips = L('chips'), ops = L('operators');
const funnel = STACK.filter((l) => l.id !== 'operators').map((l, i) => ({ ...l, n: l.pieces.filter((id) => byId[id]).length, w: 100 - i * 8 }));

// ── 1 · grid ──
const PY = [30, 170, 310];
const att = [[2, 330, 16], [58, 330, 16], [50, 312, 14], [30, 284, 10]];
const spans: string[] = [];
att.forEach(([dx, y, sag]) => {
  spans.push(`M-6 ${y + 6} Q ${(PY[0] + dx - 6) / 2} ${y + 10} ${PY[0] + dx} ${y}`);
  for (let i = 0; i < PY.length - 1; i++) { const a = PY[i] + dx, b = PY[i + 1] + dx; spans.push(`M${a} ${y} Q ${(a + b) / 2} ${y + sag} ${b} ${y}`); }
});
const ends: [number, number][] = [[446, 354], [480, 354], [466, 354], [486, 340]];
att.forEach(([dx, y, sag], k) => { const a = PY[2] + dx, [ex, ey] = ends[k]; spans.push(`M${a} ${y} Q ${(a + ex) / 2} ${Math.max(y, ey) + sag * 0.6} ${ex} ${ey}`); });

// ── 3 · hall ──
const hallRacks = [0, 1, 2, 3, 4, 5].map((k) => 280 + k * 70);

// ── 4 · rack ──
type Row = { kind: 'P' | 'C' | 'S'; y: number; h: number };
const order: Row['kind'][] = ['P', 'P', ...Array(10).fill('C'), ...Array(9).fill('S'), ...Array(8).fill('C'), 'P', 'P'];
let ry = 52;
const rows: Row[] = order.map((kind) => { const h = kind === 'S' ? 10 : 14; const r = { kind, y: ry, h }; ry += h + 2; return r; });
const computeRows = rows.filter((r) => r.kind === 'C');
const focusTray = computeRows[3];

// ── 5 · tray ──
const boards = [135, 285];
const gpuX = [200, 340];

// ── 6 · package ──
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const dies = [{ x: 318, y: 124, w: 78, h: 312 }, { x: 404, y: 124, w: 78, h: 312 }];
const blocks = dies.flatMap((d) => {
  const cols = 5, rws = 22, cw = (d.w - 8) / cols, ch = (d.h - 8) / rws;
  const out: { x: number; y: number; w: number; h: number; o: number }[] = [];
  for (let r = 0; r < rws; r++) for (let c = 0; c < cols; c++) {
    if (rnd() < 0.12) continue;
    const span = rnd() < 0.18 && c < cols - 1 ? 2 : 1;
    out.push({ x: d.x + 4 + c * cw + 0.6, y: d.y + 4 + r * ch + 0.6, w: cw * span - 1.2, h: ch - 1.2, o: 0.25 + rnd() * 0.55 });
    if (span === 2) c++;
  }
  return out;
});
const hbmY = [124, 204, 284, 364];
const caps: { x: number; y: number; w: number; h: number }[] = [];
for (let x = 214; x <= 580; x += 13) caps.push({ x, y: 76, w: 8, h: 5 }, { x, y: 86, w: 8, h: 5 }, { x, y: 469, w: 8, h: 5 }, { x, y: 479, w: 8, h: 5 });
for (let y = 118; y <= 436; y += 13) caps.push({ x: 200, y, w: 5, h: 8 }, { x: 595, y, w: 5, h: 8 });
const layers8 = Array.from({ length: 8 }, (_, i) => 486 - i * 9);

// ── 7 · lithography ──
const beam = [[262, 300], [340, 210], [452, 140], [525, 88], [610, 175], [500, 240], [640, 305], [560, 370], [600, 452]];
const mirrors = beam.slice(1, -1).map((p, i) => {
  const a = beam[i], b = beam[i + 2];
  const n1 = Math.hypot(p[0] - a[0], p[1] - a[1]), n2 = Math.hypot(b[0] - p[0], b[1] - p[1]);
  const nx = (b[0] - p[0]) / n2 - (p[0] - a[0]) / n1, ny = (b[1] - p[1]) / n2 - (p[1] - a[1]) / n1;
  return { x: p[0], y: p[1], a: (Math.atan2(ny, nx) * 180) / Math.PI + 90, mask: i === 2 };
});
const wafer: { x: number; y: number; on: boolean }[] = [];
for (let x = 70; x < 230; x += 13) for (let y = 90; y < 250; y += 16) {
  const far = Math.max(...[[x, y], [x + 12, y], [x, y + 15], [x + 12, y + 15]].map(([px, py]) => Math.hypot(px - 150, py - 170)));
  if (far < 77) wafer.push({ x, y, on: rnd() < 0.3 });
}

const n = (i: number) => String(i).padStart(2, '0');
