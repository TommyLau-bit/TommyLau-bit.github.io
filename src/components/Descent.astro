    </div></div>
    <div class="step" data-scene="1"><div class="card">
      <p class="kick kick--energy">{n(2)} · {onsite.name}</p>
      <h2>Making power next door</h2>
      <p>{onsite.what}</p>
      <p class="binds"><strong>What binds.</strong> {onsite.constraint}</p>
      <ul class="reads">{reads(onsite.pieces.slice(0, 3)).map((r) => <li><a href={r.href}>{r.title}</a></li>)}</ul>
    </div></div>

    <div class="step" data-scene="2"><div class="card">
      <p class="kick kick--energy">{n(3)} · {dist.name}</p>
      <h2>Inside the building</h2>
      <p>{dist.what}</p>
      <p>Switchgear and batteries fill one room. Copper busways carry power overhead to every rack, and coolant runs beneath the floor.</p>
    </div></div>
    <div class="step" data-scene="2"><div class="card">
      <p class="kick kick--compute">{n(3)} · {net.name}</p>
