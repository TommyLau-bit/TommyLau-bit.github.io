  .fband {
    pointer-events: auto; width: var(--w); display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem;
    padding: 0.5rem 0.8rem; border-radius: 4px; text-decoration: none; font-size: 0.85rem; font-weight: 600;
    opacity: 0; transform: translateY(6px); transition: opacity .4s ease var(--d), transform .4s ease var(--d), background .2s;
  }
  .panel.on .fband, .descent:not(.dj) .fband { opacity: 1; transform: none; }
  .fband small { font-weight: 400; color: var(--ink-3); white-space: nowrap; }
  .fband--energy { background: color-mix(in srgb, var(--accent) 14%, var(--bg)); border-left: 3px solid var(--accent); }
  .fband--compute { background: color-mix(in srgb, var(--accent-2) 12%, var(--bg)); border-left: 3px solid var(--accent-2); }
  .fband:hover { background: color-mix(in srgb, var(--ink) 8%, var(--bg)); }
  .funnel .panel-foot { align-self: flex-start; }

  /* without JavaScript: every scene shown in order */
  .descent:not(.dj) .d-stage { position: relative; height: auto; display: block; padding: 1rem; }
  .descent:not(.dj) .scene { margin: 0 auto 2rem; }
