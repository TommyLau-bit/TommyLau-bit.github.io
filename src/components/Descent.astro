    <div class="step" data-scene="5"><div class="card">
      <p class="kick kick--energy">{n(6)} · {cool.name}</p>
      <h2>And every watt comes back as heat</h2>
      <p>{cool.what}</p>
      <p class="binds"><strong>What binds.</strong> {cool.constraint}</p>
      <ul class="reads">{reads(cool.pieces).map((r) => <li><a href={r.href}>{r.title}</a></li>)}</ul>
    </div></div>

    <div class="step" data-scene="6"><div class="card">
      <p class="kick kick--energy">{n(7)} · The whole chain</p>
      <h2>All of it, for one answer on your screen</h2>
      <p>The grid, the machines at the gate, the reactors and turbines, the copper and the coolant: each layer exists to feed the rack. The slowest one sets the date for all the rest.</p>
    </div></div>
  </div>
</div>

<script>
  const root = document.getElementById('descent');
  if (root) {
    root.classList.add('dj');
    const steps = [...root.querySelectorAll<HTMLElement>('.step')];
    const cards = steps.map((s) => s.querySelector<HTMLElement>('.card')!);
    const scenes = [...root.querySelectorAll<HTMLElement>('.scene')];
    const reveal = [...root.querySelectorAll<HTMLElement>('[data-at]')];
    const rail = root.querySelector<HTMLElement>('.rail')!;
    const railN = rail.querySelector('.rail-n')!, railName = rail.querySelector('.rail-name')!, railScale = rail.querySelector('.rail-scale')!;
    // one dot per stop, so a newly drawn stop is counted without touching this
    const dots = scenes.map(() => rail.querySelector('.rail-dots')!.appendChild(document.createElement('i')));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lastStep = scenes.map((_, s) => steps.map((st) => +st.dataset.scene!).lastIndexOf(s));
    const focal = scenes.map((el) => [parseFloat(el.style.getPropertyValue('--fx')) || 50, parseFloat(el.style.getPropertyValue('--fy')) || 50]);
    const focalIn = scenes.map((el) => (el.dataset.in || '50 50').split(' ').map(Number));
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    let current = -1;

    const progress = () => {
      const line = innerHeight * (innerWidth < 860 ? 0.68 : 0.55);
      const c = cards.map((el) => { const r = el.getBoundingClientRect(); return r.top + r.height / 2; });
      if (line <= c[0]) return (line - c[0]) / innerHeight;
      for (let i = 0; i < c.length - 1; i++) if (line < c[i + 1]) return i + (line - c[i]) / (c[i + 1] - c[i]);
      return c.length - 1;
    };

    let ticking = false;
    const frame = () => {
      ticking = false;
      const p = progress();
      let top = 0, topOp = -1;
      scenes.forEach((el, s) => {
        const tin = s === 0 ? 1 : clamp((p - lastStep[s - 1] - 0.15) / 0.7);
        const tout = s === scenes.length - 1 ? 0 : clamp((p - lastStep[s] - 0.15) / 0.7);
        const zoomIn = s > 0 ? +(scenes[s - 1].dataset.zoom || 0) : 0;
        const pullIn = s > 0 ? +(scenes[s - 1].dataset.out || 0) : 0;
        const zoomOut = +(el.dataset.zoom || 0);
        const pullOut = +(el.dataset.out || 0);
        let tf = 'none', op = 1, origin = '50% 50%';
        if (tin < 1) {
          const e = ease(tin);
          op = reduce ? tin : clamp(zoomIn ? (tin - 0.45) / 0.3 : pullIn ? (tin - 0.15) / 0.35 : (tin - 0.3) / 0.5);
          if (!reduce && pullIn) {
            // the camera pulls back: this stop opens magnified on the spot the last one showed
            const [ix, iy] = focalIn[s];
            origin = `${ix}% ${iy}%`;
            tf = `translate(${((50 - ix) * (1 - e)).toFixed(2)}%, ${((50 - iy) * (1 - e)).toFixed(2)}%) scale(${Math.pow(pullIn, 1 - e).toFixed(3)})`;
          } else if (!reduce) tf = `scale(${zoomIn ? Math.pow(zoomIn, e - 1).toFixed(3) : (0.95 + 0.05 * e).toFixed(3)})`;
        } else if (tout > 0 && pullOut && !reduce) {
          const e = ease(tout);
          tf = `scale(${Math.pow(1 / pullOut, e).toFixed(3)})`;
          op = 1 - clamp((tout - 0.1) / 0.4);
        } else if (tout > 0) {
          const e = ease(tout);
          if (reduce) op = 1 - tout;
          else if (zoomOut) {
            const [fx, fy] = focal[s];
            origin = `${fx}% ${fy}%`;
            tf = `translate(${((50 - fx) * e).toFixed(2)}%, ${((50 - fy) * e).toFixed(2)}%) scale(${Math.pow(zoomOut, e).toFixed(3)})`;
            op = 1 - clamp((tout - 0.3) / 0.35);
          } else { tf = `scale(${(1 - 0.05 * e).toFixed(3)})`; op = 1 - clamp(tout / 0.5); }
        }
        el.classList.toggle('leaving', tout > 0.04);
        el.style.transformOrigin = origin;
        el.style.transform = tf;
        el.style.opacity = String(op);
        el.style.visibility = op < 0.01 ? 'hidden' : 'visible';
        if (op > topOp + 0.001) { topOp = op; top = s; }
      });
      if (top !== current) {
        current = top;
        railN.textContent = `${String(top + 1).padStart(2, '0')} / ${String(scenes.length).padStart(2, '0')}`;
        railName.textContent = scenes[top].dataset.name || '';
        railScale.textContent = scenes[top].dataset.scale || '';
        dots.forEach((d, i) => d.classList.toggle('on', i <= top));
      }
      rail.classList.toggle('shown', p > -0.6);
      reveal.forEach((el) => el.classList.toggle('on', p >= +el.dataset.at! - 0.55));
      cards.forEach((c, i) => c.classList.toggle('is-on', Math.abs(p - i) < 0.5));
    };
    const req = () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } };
    addEventListener('scroll', req, { passive: true });
    addEventListener('resize', req);
    frame();
  }
</script>

<style>
