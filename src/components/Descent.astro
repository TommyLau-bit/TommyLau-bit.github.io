  .rbar { height: 10px; background: var(--rule); border-radius: 5px; overflow: hidden; align-self: end; }
  .rbar i { display: block; height: 100%; width: 0; background: color-mix(in srgb, var(--bad) calc(var(--w) * 0.9), var(--ink-3)); border-radius: 5px; transition: width 1.1s cubic-bezier(.2,.7,.2,1); }
  .panel.on .rbar i, .descent:not(.dj) .rbar i { width: var(--w); }
  .rrow:nth-child(3) i { transition-delay: .15s; } .rrow:nth-child(4) i { transition-delay: .3s; } .rrow:nth-child(5) i { transition-delay: .45s; }
  .rclock { margin: 0; font-size: 0.78rem; color: var(--ink-2); }
