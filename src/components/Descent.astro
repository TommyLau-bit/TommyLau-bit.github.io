    .panel { padding: 0.9rem 1rem; }
    .panel-h { font-size: 0.92rem; margin-bottom: 0.5rem; }
    .rrow { grid-template-columns: 1fr; padding: 0.45rem 0; }
    .rname { grid-row: auto; font-size: 0.82rem; }
    .rname span, .panel-foot { display: none; }
    .fband { padding: 0.35rem 0.6rem; font-size: 0.75rem; }
  }
</style>
