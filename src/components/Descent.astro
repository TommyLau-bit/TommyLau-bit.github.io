  }
  .lbl--end { transform: translate(-100%, -50%); text-align: right; }
  .lbl--mid { transform: translate(-50%, -50%); text-align: center; max-width: 34%; }
  .lbl--cap { max-width: 24%; font-size: 11px; }
  .lbl b { display: block; color: var(--ink); font-weight: 650; }
