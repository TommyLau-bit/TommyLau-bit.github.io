  .s-ghost rect { fill: none; stroke: var(--ink-3); opacity: 0.35; }
  .s-ghost path { stroke: var(--ink-3); stroke-width: 0.7; opacity: 0.25; }
  .s-bay { fill: color-mix(in srgb, var(--accent-2) 14%, var(--bg)); stroke: var(--ink-3); stroke-width: 0.6; }
  .s-bay--cpu { fill: color-mix(in srgb, var(--ink) 10%, var(--bg)); }
  .s-ports { stroke: var(--ink-3); stroke-width: 4; stroke-dasharray: 2 1.5; }
  .s-ports--sw { stroke-width: 5; stroke-dasharray: 3 1.4; }
  .s-ports--thin { stroke: var(--accent-2); stroke-width: 3; opacity: .6; }
  .led { fill: var(--accent-2); }
  .led-panel { fill: color-mix(in srgb, var(--accent-2) 40%, var(--bg)); }
  .s-power { fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-dasharray: 3 3; }
  .cable { fill: var(--copper); stroke: var(--ink-2); stroke-width: 1; }
  .copper { fill: var(--copper); }
  .copper-line { fill: none; stroke: var(--copper); stroke-width: 2; }
  .tap { stroke: var(--copper); stroke-width: 1.4; }
  .hl { fill: color-mix(in srgb, var(--accent) 30%, transparent); stroke: var(--accent); stroke-width: 1.4; }
  .pipe--cool { fill: var(--cool); }
  .pipe--warm { fill: var(--accent); }
  .hose { stroke-width: 2; fill: none; }
  .hose--cool { stroke: var(--cool); }
  .hose--warm { stroke: var(--accent); }
  .fibre { fill: none; stroke: var(--accent-2); stroke-width: 1.2; opacity: .7; }
  .focus-ring { fill: none; stroke: var(--accent-2); stroke-width: 1.4; stroke-dasharray: 3 3; }
  .steam { animation: steam 4s ease-in-out infinite; }
  @keyframes steam { 50% { transform: translateY(-4px); opacity: .15; } }

  .pcb { fill: color-mix(in srgb, var(--pcb) 16%, var(--bg-elev)); stroke: var(--ink-3); }
  .trace { fill: none; stroke: color-mix(in srgb, var(--copper) 60%, var(--bg)); stroke-width: 1; }
  .osfp { fill: color-mix(in srgb, var(--accent-2) 20%, var(--bg)); stroke: var(--accent-2); stroke-width: .8; }
  .vrm { fill: color-mix(in srgb, var(--ink) 22%, var(--bg)); stroke: var(--ink-3); stroke-width: .6; }
