  .rail-dots { display: flex; gap: 4px; margin-left: 0.35rem; }
  .rail-dots i { width: 14px; height: 3px; border-radius: 2px; background: var(--rule); transition: background .3s; }
  .rail-dots i.on { background: var(--accent); }

  /* steps */
