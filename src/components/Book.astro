---
// The book as a PM's morning sheet (Tommy, 6 Nov 2026: the Physical Layer Radar
// dashboard carried onto the site in the house style). A one-line masthead, the
// morning story, then tabs: the book, the watchlist, the idea bench, the
// calendar, the notes (passed in as a slot) and how it works. The daily run
// (scheduled task physical-layer-book-daily) rewrites src/data/book.json; this
// component only reads it. Rules: CALLS-SPEC.md "The book".
import book from '../data/book.json';
import { fmtMoney, fmtPct } from '../lib/calls';
import { fmtDate } from '../utils';

const usd = (n: number) => `US$${Math.round(n).toLocaleString('en-GB')}`;
const day = (iso: string) => fmtDate(new Date(`${iso}T12:00:00+08:00`));
const short = (iso: string) => new Date(`${iso}T12:00:00+08:00`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
const pct = (n: number) => `${Math.round(n * 100)}%`;
// Rounded down, so a trade just under the 2 times rule never reads as 2.0.
const times = (r: number) => (Math.floor(r * 10) / 10).toFixed(1);
const pnl = book.equity - book.capital;
const wins = book.closed.filter((t: any) => t.result > 0).length;
const watch = [...book.watch].sort((a: any, b: any) => (b.rr ?? -1) - (a.rr ?? -1));
const firstOk = watch.find((w: any) => w.signal != null && w.stop != null) as any;

// Where a price sits between the stop (0) and the target (1), for the bars.
const at = (v: number, stop: number, target: number) => Math.max(0, Math.min(1, (v - stop) / (target - stop))) * 100;
// A label over a mark: centred, or pinned to the edge it would spill past.
const tag = (x: number) => `left:${x}%;transform:translateX(${x < 18 ? '-4px' : x > 82 ? 'calc(-100% + 4px)' : '-50%'})`;

const tabs = [
  { id: 'book', label: 'The book' },
  { id: 'watch', label: `Watchlist (${book.watch.length})` },
  { id: 'bench', label: `Idea bench (${book.bench.length})` },
  { id: 'calendar', label: 'Calendar' },
  { id: 'notes', label: 'Notes' },
  { id: 'how', label: 'How it works' },
];
---
<section class="sheet" id="book" aria-label="The book">
  <div class="sheet-mast">
    <div>
      <p class="sheet-label">The book · paper, opened {day(book.start)}</p>
      <p class="sheet-equity">{usd(book.equity)} <span class={pnl > 0 ? 'up' : pnl < 0 ? 'down' : ''}>{fmtPct(pnl / book.capital)}</span></p>
    </div>
    <ul class="sheet-facts">
      <li><strong>{pct(book.cash / book.equity)}</strong> cash</li>
      <li><strong>{book.positions.length}</strong> open</li>
      <li><strong>{book.closed.length}</strong> closed{book.closed.length > 0 && `, ${wins} won`}</li>
      <li>Prices: closes to {day(book.pricesAt)}</li>
    </ul>
  </div>

  <div class="sheet-story">
    <p class="sheet-label">This morning, {day(book.asOf)}</p>
    <h2>{book.story.headline}</h2>
    <ul>{book.story.bullets.map((b: string) => <li>{b}</li>)}</ul>
  </div>

  <nav class="sheet-tabs" role="tablist" aria-label="Research sections">
    {tabs.map((t, i) => <a role="tab" href={`#${t.id}`} data-tab={t.id} aria-selected={i === 0 ? 'true' : 'false'}>{t.label}</a>)}
  </nav>

  <div class="sheet-panel" data-panel="book" role="tabpanel">
    <h3 class="sheet-h">Open positions</h3>
    {book.positions.length === 0 ? (
      <p class="sheet-empty">None yet. {book.exposure}</p>
    ) : (
      <div class="cards">{book.positions.map((p: any) => (
        <article class="card">
          <header><a href={`/research/${p.slug}/`}>{p.company}</a> <span class="card-tk">{p.ticker}</span><span class={`card-side card-side--${p.direction.toLowerCase()}`}>{p.direction === 'LONG' ? 'Long' : 'Short'} · {usd(p.sizeUsd)}</span></header>
          <p class="card-what">{p.what ?? p.thesis}</p>
          <p class="card-big"><span class={p.result >= 0 ? 'up' : 'down'}>{fmtPct(p.result)}</span> <small>{usd(p.pnlUsd)} · bought {fmtMoney(p.currency, p.entryPrice)} on {short(p.entryDate)}, now {fmtMoney(p.currency, p.last)}</small></p>
          <div class="bar-box">
            <span class="bar-tag bar-tag--buy" style={tag(at(p.entryPrice, p.stop, p.target))}>Bought {fmtMoney(p.currency, p.entryPrice)}</span>
            <div class="bar" aria-hidden="true"><span class="bar-mark bar-mark--now" style={`left:${at(p.last, p.stop, p.target)}%`}></span><span class="bar-mark bar-mark--buy" style={`left:${at(p.entryPrice, p.stop, p.target)}%`}></span></div>
            <span class="bar-tag bar-tag--now" style={tag(at(p.last, p.stop, p.target))}>Now {fmtMoney(p.currency, p.last)}</span>
          </div>
          <p class="bar-ends"><span class="bar-end--stop">Stop {fmtMoney(p.currency, p.stop)}<small>sell at a loss</small></span><span class="bar-end--target">Target {fmtMoney(p.currency, p.target)}<small>take profit</small></span></p>
          <details><summary>Why</summary><p>{p.why}</p><p><strong>Wrong if:</strong> {p.wrongIf}</p></details>
        </article>
      ))}</div>
    )}

    {book.closed.length > 0 && (
      <>
        <h3 class="sheet-h">Closed trades</h3>
        <ul class="ledger">{book.closed.map((t: any) => (
          <li>
            <span class={t.result >= 0 ? 'up' : 'down'}>{fmtPct(t.result)}</span>
            <span><a href={`/research/${t.slug}/`}>{t.company}</a>, {t.direction === 'LONG' ? 'long' : 'short'} {fmtMoney(t.currency, t.entryPrice)} to {fmtMoney(t.currency, t.exitPrice)}, {short(t.entryDate)} to {short(t.exitDate)}: {t.exitReason.toLowerCase()}.
            <details><summary>Post-mortem</summary><p>{t.postMortem}</p></details></span>
          </li>
        ))}</ul>
      </>
    )}

    <h3 class="sheet-h">Morning log</h3>
    <ul class="ledger">{book.log.slice(-5).reverse().map((l: any) => <li><span>{short(l.date)}</span><span>{l.text}</span></li>)}</ul>
  </div>

  <div class="sheet-panel" id="watch" data-panel="watch" role="tabpanel">
    <p class="sheet-intro">Companies the book will buy once the price turns. Each card gives the price to buy above, where the book would sell at a loss (the stop) and where it would take its profit (the target). Levels as of {day(book.pricesAt)}, re-set every morning.</p>
    <p class="bar-key" aria-label="How to read the bar"><span class="k k--stop">Stop: sell at a loss</span><span class="k k--now">Now: today's price</span><span class="k k--buy">Buy: the entry price</span><span class="k k--target">Target: take profit</span></p>
    <div class="cards">{watch.map((w: any) => {
      const risk = w.signal != null && w.stop != null ? w.signal - w.stop : null;
      const reward = w.signal != null ? w.target - w.signal : null;
      return (
        <article class="card">
          <header><a href={`/research/${w.slug}/`}>{w.company}</a> <span class="card-tk">{w.ticker}</span><span class={`card-side card-side--${w.direction.toLowerCase()}`}>{w.direction === 'LONG' ? 'Long' : 'Short'} · {pct(w.size)}</span></header>
          <p class="card-what">{w.what}</p>
          {risk != null && reward != null ? (
            <>
              <p class="card-plan">{w.direction === 'SHORT' ? 'Sell short below' : 'Buy above'} <strong>{fmtMoney(w.currency, w.signal)}</strong>. Risk <strong>{fmtMoney(w.currency, risk)}</strong> a share to make <strong>{fmtMoney(w.currency, reward)}</strong>: <span class={w.rr >= 2 ? 'up' : 'down'}>{times(w.rr)} times the risk</span>.</p>
              <div class="bar-box">
                <span class="bar-tag bar-tag--buy" style={tag(at(w.signal, w.stop, w.target))}>{w.direction === 'SHORT' ? 'Short' : 'Buy'} {fmtMoney(w.currency, w.signal)}</span>
                <div class="bar" aria-hidden="true"><span class="bar-mark bar-mark--now" style={`left:${at(w.close, w.stop, w.target)}%`}></span><span class="bar-mark bar-mark--buy" style={`left:${at(w.signal, w.stop, w.target)}%`}></span></div>
                <span class="bar-tag bar-tag--now" style={tag(at(w.close, w.stop, w.target))}>Now {fmtMoney(w.currency, w.close)}</span>
              </div>
              <p class="bar-ends"><span class="bar-end--stop">Stop {fmtMoney(w.currency, w.stop)}<small>sell at a loss</small></span><span class="bar-end--target">Target {fmtMoney(w.currency, w.target)}<small>take profit</small></span></p>
              <p class="card-gap">{w.direction === 'SHORT'
                ? (w.close > w.signal ? <>Needs to fall <strong>{fmtPct(1 - w.signal / w.close).replace('+', '')}</strong> to reach the short price.</> : <>At or below the short price; sells short once the high has held three days.</>)
                : (w.close < w.signal ? <>Needs to rise <strong>{fmtPct(w.signal / w.close - 1).replace('+', '')}</strong> to reach the buy price.</> : <>At or above the buy price; buys once the low has held three days.</>)}</p>
            </>
          ) : w.stop != null ? (
            <>
              <p class="card-plan">{w.plan}</p>
              <div class="bar-box">
                <div class="bar" aria-hidden="true"><span class="bar-mark bar-mark--now" style={`left:${at(w.close, w.stop, w.target)}%`}></span></div>
                <span class="bar-tag bar-tag--now" style={tag(at(w.close, w.stop, w.target))}>Now {fmtMoney(w.currency, w.close)}</span>
              </div>
              <p class="bar-ends"><span class="bar-end--stop">{fmtMoney(w.currency, w.stop)}<small>{w.stopFrom ? `${w.stopFrom}, the stop` : 'the stop'}</small></span><span class="bar-end--target">{fmtMoney(w.currency, w.target)}<small>{w.targetFrom}, the target</small></span></p>
            </>
          ) : <p class="card-plan">{w.plan ?? `Target ${fmtMoney(w.currency, w.target)}. Now ${fmtMoney(w.currency, w.close)}.`}</p>}
          <p class="card-status">{w.status}</p>
          <details><summary>Why</summary><p>{w.why}</p></details>
        </article>
      );
    })}</div>
    <h3 class="sheet-h">Not buying</h3>
    <ul class="ledger ledger--plain">{book.avoid.map((a: any) => <li><span><a href={`/research/${a.slug}/`}>{a.company}</a>: {a.read}</span></li>)}</ul>
  </div>

  <div class="sheet-panel" id="bench" data-panel="bench" role="tabpanel">
    <p class="sheet-intro">New companies being scouted. Each morning the book adds one or two physical-layer names it does not yet cover; each Sunday the strongest, once the work is done, gets a full initiation note and Excel model and joins the book's universe. A name on the bench is never bought.</p>
    <div class="cards">{book.bench.map((n: any) => (
      <article class="card">
        <header><span class="card-name">{n.name}</span> <span class="card-tk">{n.exchange}: {n.ticker}</span><span class="card-side">{n.status}</span></header>
        <p class="card-what">{n.what}</p>
        <p class="card-plan">{n.why}</p>
        <p class="card-status">Work before a note: {n.work} Added {short(n.date)}.</p>
      </article>
    ))}</div>
  </div>

  <div class="sheet-panel" id="calendar" data-panel="calendar" role="tabpanel">
    <p class="sheet-intro">Results and decisions ahead that can move a company the book covers. The book halves a new position when results are due within ten trading days, because a result can jump the price straight past a stop.</p>
    <ul class="ledger">{book.catalysts.map((c: any) => <li><span>{short(c.date)}</span><span>{c.event}</span></li>)}</ul>
  </div>

  <div class="sheet-panel" id="notes" data-panel="notes" role="tabpanel">
    <slot name="notes" />
  </div>

  <div class="sheet-panel" id="how" data-panel="how" role="tabpanel">
    <div class="how">
      <p><strong>What this is.</strong> A {usd(book.capital)} paper portfolio, run every morning by fixed rules, on the companies covered by the notes. Every price is a closing price on a named exchange and date. Nothing is ever deleted, right or wrong.</p>
      <p><strong>Every position has a stop and a target.</strong> The stop is the price that shows the timing was wrong, so the book sells at a small loss. The target is where the book takes its profit, set from the note's own valuation. Both act on the close, with no one at the desk.</p>
      <p><strong>Reward against risk.</strong> The book only buys when the possible gain is at least twice the possible loss. {firstOk && <>Take {firstOk.company}: bought at {fmtMoney(firstOk.currency, firstOk.signal)}, it would lose {fmtMoney(firstOk.currency, firstOk.signal - firstOk.stop)} a share if the stop at {fmtMoney(firstOk.currency, firstOk.stop)} is hit, and make {fmtMoney(firstOk.currency, firstOk.target - firstOk.signal)} if the target at {fmtMoney(firstOk.currency, firstOk.target)} is hit: {times(firstOk.rr)} times the risk. </>}At two times, the book can be wrong on two trades in three and still not lose money.</p>
      <p><strong>When it buys.</strong> Not into a falling price. It waits until the lowest close of the last month is at least three days old, then buys on a close above the highest close of the previous week. The stop sits just under that low.</p>
      <p><strong>How much.</strong> 4 to 12 per cent of the book a position, by conviction; never more than 15 per cent in one company, 10 positions or 80 per cent invested. Half size when results are close. If the book falls 10 per cent from its peak, it stops buying until the losses are reviewed.</p>
      <p><strong>New companies.</strong> Scouted daily onto the idea bench; the strongest gets a full initiation note and Excel model on Sunday, and only then can it be bought.</p>
    </div>
  </div>
</section>

<script>
  // Tabs: without script every panel shows; with it, one at a time, kept in the URL hash.
  const sheet = document.querySelector('.sheet');
  if (sheet) {
    const tabs = [...sheet.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const panels = [...sheet.querySelectorAll<HTMLElement>('[data-panel]')];
    const show = (id: string) => {
      if (!panels.some((p) => p.dataset.panel === id)) id = 'book';
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
    };
    tabs.forEach((t) => t.addEventListener('click', (e) => {
      e.preventDefault();
      show(t.dataset.tab!);
      history.replaceState(null, '', `#${t.dataset.tab}`);
    }));
    show(location.hash.slice(1) || 'book');
    addEventListener('hashchange', () => show(location.hash.slice(1) || 'book'));
  }
</script>
