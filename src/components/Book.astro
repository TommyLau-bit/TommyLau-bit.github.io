---
// The book: a US$100,000 paper portfolio run by fixed rules on the notes below
// (Tommy, 6 Nov 2026, the Physical Layer Radar carried onto the site). The daily
// run (scheduled task physical-layer-book-daily) rewrites src/data/book.json;
// this component only reads it. Rules: CALLS-SPEC.md "The book".
import book from '../data/book.json';
import { fmtMoney, fmtPct } from '../lib/calls';
import { fmtDate } from '../utils';

const usd = (n: number) => `US$${Math.round(n).toLocaleString('en-GB')}`;
const day = (iso: string) => fmtDate(new Date(`${iso}T12:00:00+08:00`));
const pnl = book.equity - book.capital;
const invested = book.positions.reduce((s: number, p: any) => s + (p.value ?? 0), 0);
const wins = book.closed.filter((t: any) => t.result > 0).length;
const losses = book.closed.length - wins;
const pct = (n: number) => `${Math.round(n * 100)}%`;
const next = book.watch.filter((w: any) => w.rr != null).sort((a: any, b: any) => b.rr - a.rr).slice(0, 5);

// Equity line, drawn once the book has two or more days.
const curve = book.equityCurve;
const W = 560, H = 120, pad = 6;
let line = '';
if (curve.length > 1) {
  const ys = curve.map((c: any) => c.equity);
  const lo = Math.min(...ys, book.capital), hi = Math.max(...ys, book.capital);
  const x = (i: number) => pad + (i * (W - 2 * pad)) / (curve.length - 1);
  const y = (v: number) => H - pad - ((v - lo) / (hi - lo || 1)) * (H - 2 * pad);
  line = curve.map((c: any, i: number) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(c.equity).toFixed(1)}`).join(' ');
}
---
<section class="track book" id="book" aria-labelledby="book-title">
  <h2 id="book-title">The book</h2>
  <p class="track-intro">A {usd(book.capital)} paper portfolio, run every morning by fixed rules on the companies in the notes. Each position has a stop and a target that act on the close, entries need a target at least twice as far as the stop, and no position is more than {pct(book.rules.maxPosition)} of the book. Opened {day(book.start)}; prices are closes, last {day(book.pricesAt)}. Nothing is ever deleted.</p>

  <ul class="stat-strip" aria-label="The book at a glance">
    <li><strong>{usd(book.equity)}</strong> equity</li>
    <li><strong class={pnl > 0 ? 'up' : pnl < 0 ? 'down' : ''}>{fmtPct(pnl / book.capital)}</strong> since {day(book.start)}</li>
    <li><strong>{pct(book.cash / book.equity)}</strong> cash</li>
    <li><strong>{book.positions.length}</strong> open</li>
    <li><strong>{book.closed.length}</strong> closed{book.closed.length > 0 && <>, {wins} won, {losses} lost</>}</li>
  </ul>

  {line && (
    <figure class="chart book-curve">
      <p class="chart-title">Equity since the book opened</p>
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Book equity from ${usd(curve[0].equity)} on ${day(curve[0].date)} to ${usd(curve.at(-1).equity)} on ${day(curve.at(-1).date)}`}>
        <path class="c-line c-s1" d={line} fill="none" />
      </svg>
    </figure>
  )}

  <h3 class="book-h">Open positions</h3>
  {book.positions.length === 0 ? (
    <p class="book-empty">None. {book.exposure}</p>
  ) : (
    <div class="track-wrap"><table>
      <thead><tr><th>Company</th><th>Side</th><th>Opened</th><th>Entry</th><th>Size</th><th>Latest</th><th>P&amp;L</th><th>Stop</th><th>Target</th></tr></thead>
      <tbody>{book.positions.map((p: any) => (
        <tr>
          <td class="track-co"><a href={`/research/${p.slug}/`}>{p.company}</a> <span>{p.ticker}</span></td>
          <td>{p.direction === 'LONG' ? 'Long' : 'Short'}<span class="track-conv">, {p.conviction.toLowerCase()}</span></td>
          <td>{day(p.entryDate)}</td>
          <td>{fmtMoney(p.currency, p.entryPrice)}</td>
          <td>{usd(p.sizeUsd)}<small class="track-at">{pct(p.sizeUsd / book.capital)}</small></td>
          <td>{fmtMoney(p.currency, p.last)}</td>
          <td class={p.result >= 0 ? 'up' : 'down'}>{fmtPct(p.result)}<small class="track-at">{usd(p.pnlUsd)}</small></td>
          <td>{fmtMoney(p.currency, p.stop)}</td>
          <td>{fmtMoney(p.currency, p.target)}</td>
        </tr>
      ))}</tbody>
    </table></div>
  )}

  <h3 class="book-h">Next entries</h3>
  <p class="book-note">The five names nearest a buy signal. A position opens on its own when the stock closes above its 5-day closing high at least three days after its lowest close of the last 20, and the target is still at least twice as far away as the stop, which sits just under that low. Levels as of {day(book.pricesAt)}, re-set every morning.</p>
  <div class="track-wrap"><table>
    <thead><tr><th>Company</th><th>Side</th><th>Size</th><th>Close</th><th>Signal above</th><th>Stop</th><th>Target</th><th>Reward to risk</th><th>Status</th></tr></thead>
    <tbody>{next.map((w: any) => (
      <tr>
        <td class="track-co"><a href={`/research/${w.slug}/`}>{w.company}</a> <span>{w.ticker}</span></td>
        <td>{w.direction === 'LONG' ? 'Long' : 'Short'}<span class="track-conv">, {w.conviction.toLowerCase()}</span></td>
        <td>{pct(w.size)}</td>
        <td>{fmtMoney(w.currency, w.close)}</td>
        <td>{w.signal != null ? fmtMoney(w.currency, w.signal) : 'n/a'}</td>
        <td>{w.stop != null ? fmtMoney(w.currency, w.stop) : 'n/a'}</td>
        <td>{fmtMoney(w.currency, w.target)}<small class="track-at">{w.targetFrom}</small></td>
        <td class={w.rr != null && w.rr >= 2 ? 'up' : ''}>{w.rr != null ? `${w.rr.toFixed(1)} : 1` : 'n/a'}</td>
        <td class="book-status">{w.status}</td>
      </tr>
    ))}</tbody>
  </table></div>
  <details class="book-why">
    <summary>The full watchlist ({book.watch.length} names) and why each is on it</summary>
    <div class="track-wrap"><table>
      <thead><tr><th>Company</th><th>Side</th><th>Size</th><th>Close</th><th>Signal above</th><th>Stop</th><th>Target</th><th>Reward to risk</th><th>Status</th></tr></thead>
      <tbody>{book.watch.map((w: any) => (
      <tr>
        <td class="track-co"><a href={`/research/${w.slug}/`}>{w.company}</a> <span>{w.ticker}</span></td>
        <td>{w.direction === 'LONG' ? 'Long' : 'Short'}<span class="track-conv">, {w.conviction.toLowerCase()}</span></td>
        <td>{pct(w.size)}</td>
        <td>{fmtMoney(w.currency, w.close)}</td>
        <td>{w.signal != null ? fmtMoney(w.currency, w.signal) : 'n/a'}</td>
        <td>{w.stop != null ? fmtMoney(w.currency, w.stop) : 'n/a'}</td>
        <td>{fmtMoney(w.currency, w.target)}<small class="track-at">{w.targetFrom}</small></td>
        <td class={w.rr != null && w.rr >= 2 ? 'up' : ''}>{w.rr != null ? `${w.rr.toFixed(1)} : 1` : 'n/a'}</td>
        <td class="book-status">{w.status}</td>
      </tr>
      ))}</tbody>
    </table></div>
    <ul>{book.watch.map((w: any) => <li><strong>{w.company}.</strong> {w.why}</li>)}</ul>
  </details>
  <details class="book-why">
    <summary>Not buying ({book.avoid.length} names) and why</summary>
    <ul>{book.avoid.map((a: any) => <li><a href={`/research/${a.slug}/`}>{a.company}</a>: {a.read}</li>)}</ul>
  </details>

  {book.closed.length > 0 && (
    <>
      <h3 class="book-h">Closed trades</h3>
      <div class="track-wrap"><table>
        <thead><tr><th>Company</th><th>Side</th><th>Entry</th><th>Exit</th><th>Result</th><th>Why it closed</th></tr></thead>
        <tbody>{book.closed.map((t: any) => (
          <tr>
            <td class="track-co"><a href={`/research/${t.slug}/`}>{t.company}</a> <span>{t.ticker}</span></td>
            <td>{t.direction === 'LONG' ? 'Long' : 'Short'}</td>
            <td>{fmtMoney(t.currency, t.entryPrice)}<small class="track-at">{day(t.entryDate)}</small></td>
            <td>{fmtMoney(t.currency, t.exitPrice)}<small class="track-at">{day(t.exitDate)}</small></td>
            <td class={t.result >= 0 ? 'up' : 'down'}>{fmtPct(t.result)}<small class="track-at">{usd(t.pnlUsd)}</small></td>
            <td class="track-out">{t.exitReason}</td>
          </tr>
        ))}</tbody>
      </table></div>
      <details class="book-why">
        <summary>Post-mortems</summary>
        <ul>{book.closed.map((t: any) => <li><strong>{t.company}, {day(t.exitDate)}.</strong> {t.postMortem}</li>)}</ul>
      </details>
    </>
  )}

  <h3 class="book-h">The morning log</h3>
  <ul class="book-log">{book.log.slice(-3).reverse().map((l: any) => <li><span>{day(l.date)}</span> {l.text}</li>)}</ul>
</section>
