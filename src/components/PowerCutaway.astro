---
// The microreactor's silhouette on the Power roster: the only card with no photograph,
// because no microreactor has run yet (Tommy, 11 Nov 2026: real photos for the rest).
// House line-art style (.i-* classes in global.css), viewBox 360 x 210.
interface Props { id: string; label: string }
const { id, label } = Astro.props;

// blade rows between two sloping walls: x from a to b, wall half-heights ha -> hb around cy
const blades = (a: number, b: number, ha: number, hb: number, cy: number, n: number, gap = 4) =>
  Array.from({ length: n }, (_, i) => {
    const x = a + ((b - a) * (i + 0.5)) / n;
    const h = ha + ((hb - ha) * (x - a)) / (b - a);
    return `M${x.toFixed(1)} ${(cy - h + 2).toFixed(1)} V${cy - gap} M${x.toFixed(1)} ${cy + gap} V${(cy + h - 2).toFixed(1)}`;
  }).join(' ');
const rows = (n: number, f: (i: number) => string) => Array.from({ length: n }, (_, i) => f(i)).join(' ');
const hexCells = [[0, 0], [1, 0], [-1, 0], [0.5, 0.866], [-0.5, 0.866], [0.5, -0.866], [-0.5, -0.866], [1.5, 0.866], [-1.5, 0.866], [1.5, -0.866], [-1.5, -0.866], [0, 1.732], [0, -1.732], [2, 0], [-2, 0], [1, 1.732], [-1, 1.732], [1, -1.732], [-1, -1.732]];
const hexes = hexCells.map(([q, s]) => Array.from({ length: 6 }, (_, k) => `${k ? 'L' : 'M'}${(74 + q * 15.75 + 9 * Math.cos((Math.PI / 3) * k + Math.PI / 6)).toFixed(1)} ${(92 + s * 15.75 + 9 * Math.sin((Math.PI / 3) * k + Math.PI / 6)).toFixed(1)}`).join(' ') + ' Z').join(' ');
const triso = Array.from({ length: 30 }, (_, i) => ({ x: (74 + (4 + (i % 10) * 3.6) * Math.cos(i * 2.4)).toFixed(1), y: (92 + (4 + (i % 10) * 3.6) * Math.sin(i * 2.4)).toFixed(1) }));
const drums = Array.from({ length: 12 }, (_, i) => { const a = (i * Math.PI) / 6, cx = 74 + 53 * Math.cos(a), cy = 92 + 53 * Math.sin(a); return { cx: cx.toFixed(1), cy: cy.toFixed(1), d: `M${(cx + 6 * Math.cos(a + 1.57)).toFixed(1)} ${(cy + 6 * Math.sin(a + 1.57)).toFixed(1)} A6 6 0 0 1 ${(cx + 6 * Math.cos(a - 1.57)).toFixed(1)} ${(cy + 6 * Math.sin(a - 1.57)).toFixed(1)} Z` }; });
---
<svg class="pc-svg" viewBox="0 0 360 210" role="img" aria-label={label}>
  {id === 'micro' && (
    <g>
      <rect class="i-ground" x="0" y="190" width="360" height="20" />
      <path class="i-line" d="M0 190 H360" />
      
      <circle class="i-metal" cx="74" cy="92" r="62" />
      <circle class="i-fill" cx="74" cy="92" r="44" />
      <path class="pc-graphite" d={hexes} />
      {triso.map((t) => <circle class="pc-triso" cx={t.x} cy={t.y} r="1.4" />)}
      {drums.map((d) => <g><circle class="i-fill" cx={d.cx} cy={d.cy} r="6" /><path class="pc-absorb" d={d.d} /></g>)}
      
      <rect class="i-fill" x="160" y="96" width="70" height="66" rx="4" />
      <rect class="i-metal" x="172" y="104" width="46" height="50" rx="12" />
      <rect class="pc-core" x="184" y="116" width="22" height="26" rx="3" />
      <rect class="i-fill" x="238" y="96" width="112" height="66" rx="4" />
      <path class="i-fill" d="M250 116 L282 110 L282 148 L250 142 Z" />
      <path class="i-thin" d={blades(250, 282, 13, 19, 129, 5, 2)} />
      <path class="pc-shaft" d="M282 129 H300" />
      <rect class="i-metal" x="300" y="110" width="40" height="38" rx="4" />
      <path class="i-hot" d="M218 116 H250" />
      <path class="i-cool" d="M250 142 H218" />
      <path class="i-line" d="M156 162 H354 M156 166 H354" />
      {[180, 200, 316, 336].map((cx) => <g><circle class="i-metal" cx={cx} cy="178" r="10" /><circle class="i-thin" cx={cx} cy="178" r="4" /></g>)}
      <path class="i-lead" d="M136 92 L160 110" />
      <text class="pc-t" x="74" y="172" text-anchor="middle">core from above</text>
      <text class="pc-n" x="74" y="186" text-anchor="middle">TRISO fuel, control drums</text>
      <text class="pc-t" x="195" y="88" text-anchor="middle">reactor</text>
      <text class="pc-t" x="294" y="88" text-anchor="middle">helium turbine</text>
      <text class="pc-n" x="255" y="204" text-anchor="middle">on a trailer</text>
    </g>
  )}
</svg>
