---
import { LICENCE_URL } from '../data/journal-photos';
// Power: every way to power an AI data centre, as a roster of player cards.
// Published on Tommy's word, 11 Nov 2026. Kept simple and fun on
// purpose: photo, a radar of A to E grades, ability, weakness. The numbers behind every grade sit in
// one fold at the bottom. Data in src/data/power.ts; grade bands in power-ratings.ts.
import Base from '../layouts/Base.astro';
import { GROUPS, CARDS } from '../data/power';
import { PHOTOS } from '../data/power-photos';
import { RATINGS, GRADES, GRADE_WORD, gradeOf, bandText, figure, type Grade, type RatingKey } from '../data/power-ratings';
import { CHAPTERS } from '../data/stack';

const chapterN = (slug: string) => CHAPTERS.findIndex((c) => c.slug === slug) + 1;
const chapterName = (slug: string) => CHAPTERS.find((c) => c.slug === slug)?.name ?? slug;
const gridPhoto = PHOTOS['grid'];
const cards = CARDS.filter((c) => c.id !== 'grid').map((c) => {
  const g = Object.fromEntries(RATINGS.map((R) => [R.key, gradeOf(R, c.stats[R.input])])) as Record<RatingKey, Grade>;
  const claims = RATINGS.filter((R) => c.stats[R.input]?.claim).map((R) => ({ key: R.key, name: R.name, text: c.stats[R.input].claim as string }));
  return { ...c, g, claims, photo: PHOTOS[c.id] };
});

// The radar: one axis per rating, A on the rim, E near the centre. "?" sits at the centre
// (no sourced number), "∞" on the rim.
const CX = 120, CY = 104, RR = 62, N = RATINGS.length;
const reach: Record<Grade, number> = { A: 1, B: 0.8, C: 0.6, D: 0.4, E: 0.2, '∞': 1, '?': 0 };
const at = (i: number, f: number) => {
  const a = -Math.PI / 2 + (2 * Math.PI * i) / N;
  return [CX + RR * f * Math.cos(a), CY + RR * f * Math.sin(a)];
};
const poly = (fs: number[]) => fs.map((f, i) => at(i, f).map((x) => x.toFixed(1)).join(',')).join(' ');
const shape = (c: { g: Record<RatingKey, Grade> }) => poly(RATINGS.map((R) => reach[c.g[R.key]]));
const rings = [1, 0.8, 0.6, 0.4, 0.2].map((f) => poly(RATINGS.map(() => f)));
const spokes = RATINGS.map((_, i) => at(i, 1));
const labels = RATINGS.map((R, i) => { const [x, y] = at(i, 1.42); return { key: R.key, x: x.toFixed(1), y: y.toFixed(1), t: R.name }; });
const gradeClass = (x: Grade) => (x === 'A' || x === 'B' || x === '∞' ? 'is-hi' : x === 'D' || x === 'E' ? 'is-lo' : x === '?' ? 'is-na' : '');
---
<Base title="Power" description="Every way to power an AI data centre, as a roster of player cards: the grid, gas turbines, engines, fuel cells, solar, batteries and reactors." wide>
  <header class="article-head pw-head">
    <h1>Power: the roster</h1>
    <p class="pw-lede">Every way to power an AI data centre, as a team of players. The grid comes first as the default every builder starts from; the cards are the machines they build when it makes them wait.</p>
    <dl class="pw-key">
      {RATINGS.map((R) => <div><dt>{R.name}</dt><dd>{R.hint}</dd></div>)}
    </dl>
    <p class="pw-keynote">Graded A (excellent) to E (very weak), each from one sourced number: <a href="#formulas">see the bands</a>.</p>
  </header>

  {GROUPS.map((g) => (
    <section class="pw-group" id={g.id}>
      <div class="pw-ghead">
        <h2>{g.name}</h2>
        <p>{g.why}</p>
      </div>
      {g.id === 'grid' ? (
      <div class="pw-grid">
        {gridPhoto && <figure class="pw-grid-photo">
          <img src={gridPhoto.src} alt={gridPhoto.alt} loading="lazy" decoding="async" style={gridPhoto.pos ? `object-position:${gridPhoto.pos}` : undefined} />
          <figcaption>{gridPhoto.caption}. Photo: <a href={gridPhoto.page} rel="noopener">{gridPhoto.credit}</a>, {LICENCE_URL[gridPhoto.licence] && <a href={LICENCE_URL[gridPhoto.licence]} rel="noopener license">{gridPhoto.licence}</a>}{LICENCE_URL[gridPhoto.licence] ? ', resized' : gridPhoto.licence}</figcaption>
        </figure>}
        <div class="pw-grid-text">
          <h3>Why the grid is a problem</h3>
          <ul>
            <li>No date: Dominion, in Virginia, has none yet for 45 GW of data centres. A request today waits 5 to 6 years or more.</li>
            <li>Even approved sites can be paused: Texas froze switch-ons for big data centres in August 2026.</li>
            <li>A data centre takes 1 to 2 years to build. A large transformer alone is quoted at 3 to 5 years.</li>
          </ul>
          <h3>Why builders go elsewhere</h3>
          <ul>
            <li>A date they can plan on: a rented gas fleet in months, gas engines in about 2 to 3 years.</li>
            <li>Their own schedule, not a utility's queue.</li>
            <li>The catch: the machine makers have queues too, and gas still comes by pipe.</li>
          </ul>
          <p class="pw-src-line">Sources: Dominion (May and September 2026); ERCOT (20 August 2026); FERC (18 June 2026); US Department of Energy (July 2024); the cards below. Where the grid is quick, as in Johor (12 months), builders stay on it.</p>
          <p class="pcard-ch"><a href="/journal/the-queue-not-the-chip/#why-did-so-many-data-centres-come-to-johor">Chapter {chapterN('the-queue-not-the-chip')}: {chapterName('the-queue-not-the-chip')}</a><a href="/journal/america-rations-the-plug/#which-step-takes-longest-and-why-can-no-rule-hurry-it">Chapter {chapterN('america-rations-the-plug')}: {chapterName('america-rations-the-plug')}</a><a href="/journal/building-your-own-power/">Chapter {chapterN('building-your-own-power')}: {chapterName('building-your-own-power')}</a></p>
        </div>
      </div>
      ) : (
      <div class="pw-cards">
        {cards.filter((c) => c.group === g.id).map((c) => (
          <article class="pcard" id={c.id} data-flip>
            <div class="pcard-photo">
              {c.photo && <img src={c.photo.src} alt={c.photo.alt} loading="lazy" decoding="async" style={c.photo.pos ? `object-position:${c.photo.pos}` : undefined} />}
              <span class="pcard-role">{c.role}</span>
            </div>
            <div class="pcard-body">
              <h3>{c.name}</h3>
              {c.examples && <p class="pcard-ex">{c.examples}</p>}
              <div class="pcard-stats">
                <svg class="pcard-radar" viewBox="0 -4 240 216" role="img" aria-label={`${c.name}: ` + RATINGS.map((R) => `${R.name} ${c.g[R.key]}`).join(', ')}>
                  {rings.map((r) => <polygon class="rd-ring" points={r} />)}
                  {spokes.map(([x, y]) => <line class="rd-ring" x1={CX} y1={CY} x2={x.toFixed(1)} y2={y.toFixed(1)} />)}
                  <polygon class="rd-shape" points={shape(c)} />
                  {labels.map((l) => (
                    <g>
                      <text class="rd-label" x={l.x} y={(+l.y - 10).toFixed(1)} text-anchor="middle">{l.t}</text>
                      <text class={`rd-grade ${gradeClass(c.g[l.key])}`} x={l.x} y={(+l.y + 9).toFixed(1)} text-anchor="middle">{c.g[l.key]}</text>
                    </g>
                  ))}
                </svg>
                <ul class="pcard-grades">
                  {RATINGS.map((R) => (
                    <li>
                      <span class="pg-name">{R.name}{c.claims.some((x) => x.key === R.key) && <sup>*</sup>}</span>
                      <span class="pg-fig">{figure(R, c.stats[R.input])}</span>
                    </li>
                  ))}
                </ul>
              </div>
              {c.claims.map((x) => <p class="pcard-claim">* {x.name}: {x.text}.</p>)}
              <p class="pcard-ab"><span>Special ability</span>{c.ability}</p>
              <p class="pcard-wk"><span>Weakness</span>{c.weakness}</p>
              <p class="pcard-ch">
                {c.chapters.map((ch) => <a href={`/journal/${ch.slug}/${ch.anchor ? `#${ch.anchor}` : ''}`}>Chapter {chapterN(ch.slug)}: {chapterName(ch.slug)}</a>)}
              </p>
              {c.photo && <p class="pcard-credit">{c.photo.caption}. Photo: <a href={c.photo.page} rel="noopener">{c.photo.credit}</a>, {LICENCE_URL[c.photo.licence] && <a href={LICENCE_URL[c.photo.licence]} rel="noopener license">{c.photo.licence}</a>}{LICENCE_URL[c.photo.licence] ? ', resized' : c.photo.licence}</p>}
            </div>
          </article>
        ))}
      </div>
      )}
    </section>
  ))}

  <details class="pw-how" id="formulas">
    <summary>How the grades are worked out</summary>
    <p>Each grade reads one sourced number and nothing else, through the bands below; a range uses its middle. A number that could not be found in a primary source grades ?, and a machine that needs no fuel grades ∞ on Stamina. There is no overall grade: the ratings measure different things, and the role on each card says what it is for.</p>
    <table class="pw-ftable pw-bands">
      <thead><tr><th scope="col">Rating</th><th scope="col">Reads</th>{GRADES.map((G) => <th scope="col">{G} <small>{GRADE_WORD[G]}</small></th>)}</tr></thead>
      <tbody>
        {RATINGS.map((R) => <tr><th scope="row">{R.name}</th><td>{R.inputName}</td>{bandText(R).map((t, i) => <td data-g={GRADES[i]}>{t}</td>)}</tr>)}
      </tbody>
    </table>
    <h3>The numbers behind each card</h3>
    <div class="pw-src">
      {cards.map((c) => (
        <div>
          <h4>{c.name}</h4>
          <ul>
            {RATINGS.map((R) => {
              const s = c.stats[R.input];
              if (!s) return null;
              return <li><b>{R.name}:</b> {s.display}{s.source && <> ({s.url ? <a href={s.url} rel="noopener">{s.source}</a> : s.source}{s.date && `, ${s.date}`})</>}</li>;
            })}
          </ul>
        </div>
      ))}
    </div>
    <p class="sources">Personal research, not investment advice. Grades compare machines, not companies, and say nothing about any share.</p>
  </details>
</Base>

<script is:inline>
  // cards flip in as they reach the screen. Without the script, or with
  // reduced motion, every card is simply shown.
  (function () {
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-shown'); e.target.classList.remove('is-hidden'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -10% 0px' });
    document.querySelectorAll('[data-flip]').forEach(function (c) { if (c.getBoundingClientRect().top < innerHeight) return; c.classList.add('is-hidden'); io.observe(c); });
  })();
</script>

<style is:global>
  .pw-head { padding-bottom: 0.5rem; }
  .pw-head .kicker { color: var(--accent); }
  .pw-lede { font-size: 1.15rem; color: var(--ink-2); max-width: 40rem; margin: 0; }

  .pw-group { margin: 2.75rem 0 0; scroll-margin-top: 3.5rem; }
  .pw-ghead { border-top: 2px solid var(--ink); padding-top: 0.9rem; margin-bottom: 1.25rem; }
  .pw-ghead h2 { font-family: var(--sans); font-size: 1.5rem; margin: 0 0 0.3rem; letter-spacing: -0.01em; }
  .pw-ghead p { margin: 0; color: var(--ink-2); max-width: 44rem; }

  .pw-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 1.5rem; align-items: start; font-family: var(--sans); }
  .pw-grid-photo { margin: 0; }
  .pw-grid-photo img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 12px; }
  .pw-grid-photo figcaption { font-size: 0.75rem; color: var(--ink-3, var(--ink-2)); margin-top: 0.4rem; }
  .pw-grid-lead { margin: 0 0 0.6rem; font-size: 1.02rem; }
  .pw-grid h3 { font-size: 1.05rem; margin: 1.1rem 0 0.4rem; }
  .pw-grid ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.55rem; font-size: 0.95rem; line-height: 1.5; }
  .pw-src-line { display: block; font-size: 0.78rem; color: var(--ink-2); margin-top: 0.15rem; }
  .pw-grid-text > .pw-src-line, .pw-grid-text > .pcard-ch { margin-top: 0.9rem; }
  @media (max-width: 760px) { .pw-grid { grid-template-columns: 1fr; } }
  .pw-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1.25rem; }

  /* the player card */
  .pcard {
    --tier: #8a6a3d; --tier-2: #c8a46a;
    --hot: #f87171; --cool: #22d3ee; --fuel: #f59e0b; --metal: transparent;
    position: relative; display: flex; flex-direction: column; overflow: hidden;
    background: var(--bg-elev); border-radius: 14px; font-family: var(--sans); scroll-margin-top: 3.5rem;
    border: 2px solid var(--tier);
    box-shadow: 0 10px 24px -16px rgba(0,0,0,.5);
    transition: transform .55s cubic-bezier(.2,.8,.2,1), opacity .55s ease, filter .55s ease;
  }
  .pcard.is-hidden { opacity: 0; transform: translateY(18px) scale(0.97); filter: grayscale(1); }
  .pcard.is-shown { opacity: 1; transform: none; filter: none; }

  .pcard-photo { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: #111; }
  .pcard-photo img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
  .pcard-photo::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.35) 0%, rgba(0,0,0,0) 35%); pointer-events: none; z-index: 1; }
  .pcard-role { position: absolute; top: 0.75rem; left: 0.75rem; z-index: 2; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; background: var(--tier); border-radius: 6px; padding: 0.3rem 0.6rem; box-shadow: 0 2px 8px rgba(0,0,0,.35); }
  .pw-key { display: grid; gap: 0.3rem; max-width: 44rem; margin: 1.1rem 0 0.4rem; font-family: var(--sans); font-size: 0.9rem; }
  .pw-key div { display: flex; gap: 0.4rem; align-items: baseline; }
  .pw-key dt { font-weight: 800; white-space: nowrap; }
  .pw-key dt::after { content: ':'; }
  .pw-key dd { margin: 0; color: var(--ink-2); }
  .pw-keynote { font-family: var(--sans); font-size: 0.8rem; color: var(--ink-3); margin: 0; }
  .pcard-claim { margin: 0.35rem 0 0; font-size: 0.75rem; color: var(--ink-3); }


  .pcard-body { padding: 0.85rem 0.95rem 0.8rem; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
  .pcard-body h3 { margin: 0; font-size: 1.1rem; line-height: 1.2; letter-spacing: -0.01em; }
  .pcard-ex { margin: -0.4rem 0 0; font-size: 0.78rem; color: var(--ink-3); line-height: 1.35; }

  .pcard-stats { display: grid; gap: 0.35rem; }
  .pcard-radar { display: block; width: 100%; max-width: 17rem; height: auto; margin: 0 auto; }
  .rd-ring { fill: none; stroke: var(--rule); stroke-width: 1; }
  .rd-shape { fill: var(--tier); fill-opacity: 0.35; stroke: var(--tier); stroke-width: 2.2; stroke-linejoin: round; }
  .rd-label { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; fill: var(--ink-3); }
  .rd-grade { font-family: var(--sans); font-size: 21px; font-weight: 900; fill: var(--ink); }
  .rd-grade.is-hi { fill: var(--good); }
  .rd-grade.is-lo { fill: var(--bad); }
  .rd-grade.is-na { fill: var(--ink-3); }
  .pcard-grades { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.3rem 0.8rem; }
  .pcard-grades li { font-size: 0.72rem; line-height: 1.25; }
  .pg-name { display: block; color: var(--ink-2); font-weight: 700; }
  .pcard-grades sup { font-size: 0.7em; }
  .pg-fig { display: block; color: var(--ink-3); }
  .pw-bands td[data-g] { white-space: nowrap; }
  @media (max-width: 560px) { .pw-bands td[data-g]::before { content: attr(data-g) '  '; font-weight: 800; display: inline-block; width: 1.4rem; } }
  .pw-bands th small { display: block; font-weight: 500; color: var(--ink-3); }

  .pcard-ab, .pcard-wk { margin: 0; font-size: 0.86rem; line-height: 1.4; }
  .pcard-ab span, .pcard-wk span { display: block; font-size: 0.62rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .pcard-ab span { color: var(--good); }
  .pcard-wk span { color: var(--bad); }
  .pcard-ch { margin: auto 0 0; display: flex; flex-direction: column; gap: 0.1rem; font-size: 0.8rem; font-weight: 650; }
  .pcard-ch a { color: var(--accent); text-decoration: none; }
  @media (hover: hover) { .pcard-ch a:hover { text-decoration: underline; } }
  .pcard-credit { margin: 0; font-size: 0.66rem; line-height: 1.35; color: var(--ink-3); }
  .pcard-credit a { color: var(--ink-3); }

  .pw-how { margin: 3.5rem 0 2rem; max-width: 52rem; font-family: var(--sans); font-size: 0.88rem; border-top: 1px solid var(--rule); padding-top: 1rem; scroll-margin-top: 3.5rem; }
  .pw-how summary { cursor: pointer; font-weight: 700; font-size: 1rem; }
  .pw-how h3 { font-size: 1rem; margin: 1.5rem 0 0.5rem; }
  .pw-ftable { border-collapse: collapse; width: 100%; margin: 1rem 0; }
  .pw-ftable th, .pw-ftable td { text-align: left; vertical-align: top; padding: 0.5rem; border-bottom: 1px solid var(--rule); }
  .pw-ftable code { font-family: var(--mono); font-size: 0.8rem; }
  .pw-ftable small { color: var(--ink-3); }
  .pw-src { columns: 2 22rem; column-gap: 2rem; }
  .pw-src > div { break-inside: avoid; margin-bottom: 1rem; }
  .pw-src h4 { margin: 0 0 0.3rem; font-size: 0.88rem; }
  .pw-src ul { margin: 0; padding-left: 1rem; color: var(--ink-2); font-size: 0.78rem; line-height: 1.45; }
  .pw-src a { color: var(--ink-2); }
  @media (max-width: 560px) {
    .pw-ftable thead { display: none; }
    .pw-ftable tr { display: block; border-bottom: 1px solid var(--rule); padding: 0.4rem 0; }
    .pw-ftable th, .pw-ftable td { display: block; border: 0; padding: 0.15rem 0; }
  }
</style>
