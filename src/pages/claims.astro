---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CLAIMS, homeOf, claimHref } from '../data/claims';
import { fmtDate } from '../utils';
const posts = await getCollection('journal', ({ data }) => !data.draft);
const byId = Object.fromEntries(posts.map((p) => [p.id, p]));
// A claim shows once the piece that carries it is live: its own piece, or the
// deep piece it merged into. Its date is its own, never the deep piece's.
const rows = CLAIMS.filter((c) => byId[homeOf(c)])
  .map((c) => { const p = byId[homeOf(c)]; return { c, p, date: c.date ? new Date(c.date) : p.data.date }; })
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());
---
<Base title="Claims" description="Every claim this journal makes, dated, with what would prove it wrong and the evidence to watch.">
  <header class="article-head">
    <h1>The claims I have made</h1>
    <aside class="plain">
      <p class="label">In plain English</p>
      <p>Every Analysis piece on this site makes a claim and names the evidence that would prove it wrong. This page lists them all in one place, newest first. Each claim is fixed on the day its piece went live and is never reworded afterwards. Where a claim became a call on a company, the note is on the <a href="/research/">research page</a>.</p>
    </aside>
  </header>

  <ol class="ledger">
    {rows.map(({ c, p, date }) => (
      <li class="claim" id={c.id}>
        <span class="claim-date">{fmtDate(date)}</span>
        <p class="claim-text">{c.claim}</p>
        <p class="claim-piece">From <a href={claimHref(c)}>{p.data.title}</a></p>
        <details class="claim-detail">
          <summary>What would prove me wrong, and what I watch</summary>
          <p class="claim-sub">Wrong if</p>
          <p>{c.breaksIf}</p>
          <p class="claim-sub">Evidence I watch</p>
          <ul>{c.watch.map((w) => <li>{w}</li>)}</ul>
        </details>
      </li>
    ))}
  </ol>

  <div class="prose">
    <p class="sources">{rows.length} claims. Explainer pieces teach a mechanism and make no prediction, so they do not appear here. Personal research, not investment advice.</p>
  </div>
</Base>
