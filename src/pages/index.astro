---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { CLAIMS } from '../data/claims';
import { NUMBERS } from '../data/numbers';
import { STACK } from '../data/stack';
import { getCollection } from 'astro:content';
import { SITE, READING_ORDER } from '../config';
const all = await getCollection('journal', ({ data }) => !data.draft);
const posts = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const byId = Object.fromEntries(all.map((p) => [p.id, p]));
const first = READING_ORDER.map((id) => byId[id]).find(Boolean);
---
<Base wide>
  <section class="hero hero--compact">
    <h1>The AI buildout has a physical layer.</h1>
    <p>{SITE.description}</p>
    {first && (
      <p class="hero-start">
        New here? Begin with <a href={`/journal/${first.id}/`}>{first.data.title}</a>,
        or see <a href="/start/">where to start</a>.
      </p>
    )}
  </section>
  <nav class="ways-in" aria-label="Ways into the site">
    <a href="/map/"><strong>The map</strong><span>{STACK.length} layers from the grid to the chip, and what binds in each.</span></a>
    <a href="/claims/"><strong>The claims</strong><span>{CLAIMS.length} calls I am tracking in public, and what would prove each wrong.</span></a>
    <a href="/numbers/"><strong>The numbers</strong><span>{NUMBERS.length} physical figures behind the buildout, dated and sourced.</span></a>
  </nav>
  <section class="grid">
    {posts.map((p) => <Card p={p} />)}
  </section>
</Base>
