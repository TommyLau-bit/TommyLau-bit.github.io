---
import Base from '../layouts/Base.astro';
import Descent from '../components/Descent.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';
import { fmtDate } from '../utils';
import { STACK, layerOf } from '../data/stack';
const all = await getCollection('journal', ({ data }) => !data.draft);
const posts = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const byId = Object.fromEntries(all.map((p) => [p.id, p]));
// one section per layer, grid to chip; pieces newest first within each.
// A piece listed under two layers shows once, under its home layer (layerOf).
// Every layer keeps its section (and its #id anchor, which the descent and the
// rest of the site link to), even one whose only piece lives under another layer.
const layers = STACK.map((l, i) => ({
  ...l,
  n: String(i + 1).padStart(2, '0'),
  posts: posts.filter((p) => layerOf(p.id)?.id === l.id),
  also: l.pieces.map((id) => byId[id]).filter((p) => p && layerOf(p.id)?.id !== l.id),
})).filter((l) => l.posts.length > 0 || l.also.length > 0);
const mapped = new Set(STACK.flatMap((l) => l.pieces));
const other = posts.filter((p) => !mapped.has(p.id));
const homeOf = (id: string) => layers.find((l) => l.id === layerOf(id)?.id);
---
<Base wide>
  <section class="hero hero--compact">
    <h1>The AI buildout has a physical layer.</h1>
    <p>{SITE.description}</p>
    <p class="hero-start">Read the pieces below, or <a href="#descent">follow the power down</a> from the grid to the chip.</p>
  </section>

  <section class="home-list" aria-label="The pieces, from the grid to the chip">
    <ol class="home-rows">
      {layers.map((l) => (
        <li class={`home-row home-row--${l.kind}`} id={l.id}>
          <p class="home-row-n">Layer {l.n} · {l.name}</p>
          <ul class="home-row-pieces">
            {l.posts.map((p) => (
              <li><a href={`/journal/${p.id}/`}>{p.data.title}</a><time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time></li>
            ))}
            {l.also.map((p) => {
              const h = homeOf(p.id);
              return <li class="home-row-also">Covered in <a href={`/journal/${p.id}/`}>{p.data.title}</a>{h && <>, under <a href={`#${h.id}`}>Layer {h.n}</a></>}.</li>;
            })}
          </ul>
        </li>
      ))}
      {other.length > 0 && (
        <li class="home-row" id="other">
          <p class="home-row-n">Other</p>
          <ul class="home-row-pieces">
            {other.map((p) => <li><a href={`/journal/${p.id}/`}>{p.data.title}</a><time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time></li>)}
          </ul>
        </li>
      )}
    </ol>
  </section>

  <p class="home-walk">Or follow the power down, stop by stop.</p>
  <Descent />
</Base>
