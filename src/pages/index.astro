---
import Base from '../layouts/Base.astro';
import Descent from '../components/Descent.astro';
import { getCollection } from 'astro:content';
import { fmtDate } from '../utils';
import { CHAPTERS, layerOf } from '../data/stack';
const all = await getCollection('journal', ({ data }) => !data.draft);
const byId = Object.fromEntries(all.map((p) => [p.id, p]));
// The story in seven chapters (stack.ts CHAPTERS), each handing off to the next.
// The first chapter of each layer also carries that layer's #id, which the descent
// and old /map/#layer links land on.
const seen = new Set<string>();
const chapters = CHAPTERS.filter((c) => byId[c.slug]).map((c, i) => {
  const layer = layerOf(c.slug);
  const anchor = layer && !seen.has(layer.id) ? (seen.add(layer.id), layer.id) : undefined;
  return { ...c, n: i + 1, p: byId[c.slug], layer, anchor };
});
const mapped = new Set(CHAPTERS.map((c) => c.slug));
const other = all.filter((p) => !mapped.has(p.id)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// "The equipment queue: transformer makers..." shows as a headline with a line under it.
const split = (t: string) => {
  const m = t.match(/^(.+?)(?::\s|\.\s)(.+)$/);
  return m ? [m[1], m[2].charAt(0).toUpperCase() + m[2].slice(1)] : [t, ''];
};
---
<Base wide>
  <section class="hero hero--compact">
    <h1>AI's limit is power.</h1>
    <p>Demand for power has outrun the grid, so AI data centres look for a faster way in or build their own. Every way around the grid has its own queue: the equipment makers, the turbine makers, the winter night and the reactors' fuel. This journal follows that one problem in seven chapters, from the grid connection to the reactor, from primary sources.</p>
    <p class="hero-start">Read the chapters in order, or <a href="#descent">follow the power</a> stop by stop.</p>
  </section>

  <section class="home-list" aria-label="The story in seven chapters">
    <ol class="home-rows">
      {chapters.map((c) => (
        <li class="home-row home-row--energy" id={c.slug}>
          {c.anchor && <span class="home-anchor" id={c.anchor}></span>}
          <p class="home-row-n">Chapter {c.n}{c.layer && <> · {c.layer.name}</>}</p>
          <ul class="home-row-pieces">
            <li class="home-piece"><a href={`/journal/${c.slug}/`}><span class="home-piece-h">{split(c.p.data.title)[0]}</span>{split(c.p.data.title)[1] && <span class="home-piece-d">{split(c.p.data.title)[1]}</span>}</a><time datetime={c.p.data.date.toISOString()}>{fmtDate(c.p.data.date)}</time></li>
            <li class="home-next">{c.next}</li>
          </ul>
        </li>
      ))}
      {other.length > 0 && (
        <li class="home-row" id="other">
          <p class="home-row-n">Other</p>
          <ul class="home-row-pieces">
            {other.map((p) => <li class="home-piece"><a href={`/journal/${p.id}/`}><span class="home-piece-h">{split(p.data.title)[0]}</span>{split(p.data.title)[1] && <span class="home-piece-d">{split(p.data.title)[1]}</span>}</a><time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time></li>)}
          </ul>
        </li>
      )}
    </ol>
  </section>

  <p class="home-walk">Or follow the power, stop by stop.</p>
  <Descent />
</Base>
