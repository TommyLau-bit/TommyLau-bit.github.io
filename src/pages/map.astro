---
// The map became the homepage (Tommy, 30 Oct 2026). Old /map/ and /map/#<layer>
// links land on / and /#<layer>: the script keeps the fragment, which a plain
// meta refresh would drop.
import { SITE } from '../config';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Redirecting to: /</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={`${SITE.url}/`} />
  <script is:inline>location.replace('/' + location.hash);</script>
  <meta http-equiv="refresh" content="0;url=/" />
</head>
<body><a href="/">The map is now the homepage</a></body>
</html>
