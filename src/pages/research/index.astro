---
import Base from '../../layouts/Base.astro';
import Book from '../../components/Book.astro';
import { CLAIMS, claimOf, homeOf } from '../../data/claims';
import { STACK, layerOf } from '../../data/stack';
import { BASE_VALUE } from '../../data/notes';
import { getPitches, fmtMoney, fmtPct } from '../../lib/calls';
import { bookStatus } from '../../lib/book';
import { fmtDate } from '../../utils';
const pitches = await getPitches();

// Two parts (Tommy, 6 Nov 2026): the book is the record, the notes are the
// reasoning. The library carries no calls, targets or returns of its own; it
// shows what each note found and where that company stands in the book.
const layerIdx = (p: (typeof pitches)[number]) => {
  if (p.data.layer && STACK.some((l) => l.id === p.data.layer)) return STACK.findIndex((l) => l.id === p.data.layer);
  const c = p.data.claims[0] ? claimOf(p.data.claims[0]) : undefined;
  const l = c ? layerOf(homeOf(c)) : undefined;
  return l ? STACK.indexOf(l) : STACK.length;
};
const groups = STACK.map((l, i) => ({ layer: l, rows: pitches.filter((p) => layerIdx(p) === i) }))
  .concat([{ layer: { id: 'other', name: 'Other' } as any, rows: pitches.filter((p) => layerIdx(p) >= STACK.length) }])
  .filter((g) => g.rows.length > 0);
for (const g of groups) g.rows.sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---
<Base title="Research" description="A US$100,000 paper book run every morning with stops and targets, and the initiation notes behind it, on the companies in the physical layer of AI." wide>
  <header class="research-head">
    <h1>Research</h1>
    <p>A paper portfolio run every morning on the companies that build the physical layer of AI, with the notes and models behind every name. Start with the book; open the Notes tab for the reasoning. The journal's {CLAIMS.length} dated claims are on <a href="/claims/">the claims page</a>.</p>
  </header>

  <Book>
  <section class="track" slot="notes" id="notes-list" aria-labelledby="notes-h">
    <h2 id="notes-h">The notes</h2>
    <p class="track-intro">{pitches.length} initiation notes, grouped by layer from the grid to the chip, newest first. Each sets its own base value per share against the price on the day it was published; the book uses that value as its target. Open a note for the thesis, the valuation, the risks and what would prove it wrong.</p>
    <div class="track-wrap">
      <table>
        <thead><tr><th>Company</th><th>Published</th><th>Price then</th><th>Base value</th><th>Gap then</th><th>In the book</th><th>Files</th></tr></thead>
        {groups.map((g) => (
          <tbody>
            <tr class="track-group"><th colspan="7"><div class="track-group-in"><span class="track-group-when">{g.layer.name}</span> <span class="track-group-title">{g.rows.length} {g.rows.length === 1 ? 'note' : 'notes'}</span></div></th></tr>
            {g.rows.map((p) => {
              const c = p.data.call;
              const base = BASE_VALUE[p.id];
              const gap = base != null ? base / c.price - 1 : null;
              const s = bookStatus(p.id);
              return (
                <tr>
                  <td class="track-co"><a href={`/research/${p.id}/`}>{p.data.company}</a> <span>{p.data.ticker}</span></td>
                  <td>{p.data.date && fmtDate(p.data.date)}</td>
                  <td>{fmtMoney(c.currency, c.price)}</td>
                  <td>{base != null ? fmtMoney(c.currency, base) : 'n/a'}</td>
                  <td class={gap == null ? '' : gap >= 0 ? 'up' : 'down'}>{gap != null ? fmtPct(gap) : ''}</td>
                  <td class={`book-in book-in--${s.kind}`}>{s.label}{s.kind === 'watch' && s.detail && <small class="track-at">{s.detail}</small>}</td>
                  <td class="track-files"><a href={p.data.files.pdf}>Note</a> <a href={p.data.files.xlsx}>Model</a></td>
                </tr>
              );
            })}
          </tbody>
        ))}
      </table>
    </div>
  </section>
  </Book>

  <p class="research-foot">These notes and the book are the author's own analysis, not investment advice. The book is paper money. The author holds no position in any company covered unless a note says so.</p>
</Base>
