---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SCORECARD_REFRESHED } from '../../data/calls';
import { getPitches, latest, fmtMoney, fmtPct, callLabel } from '../../lib/calls';
import { fmtDate } from '../../utils';
import { claimOf, homeOf, claimHref } from '../../data/claims';
const pitches = await getPitches();
const posts = await getCollection('journal', ({ data }) => !data.draft);
const rows = pitches.map((p) => ({ p, ...latest(p) }));
// The deep piece each note rests on: the piece that carries its first claim today.
const restsOn = (p: (typeof pitches)[number]) => {
  const c = claimOf(p.data.claims[0]);
  const piece = c && posts.find((x) => x.id === homeOf(c));
  return c && piece ? { href: claimHref(c), title: piece.data.title } : undefined;
};
const longs = pitches.filter((p) => p.data.call.direction === 'LONG').length;
const shorts = pitches.filter((p) => p.data.call.direction === 'SHORT').length;
const noCalls = pitches.filter((p) => p.data.call.direction === 'NO CALL').length;
const dirClass = (p: (typeof pitches)[number]) => `note-call note-call--${(p.data.call.direction ?? '').toLowerCase().replace(' ', '')}`;
---
<Base title="Research" description="Initiation notes on companies in the physical layer of AI, each with the model behind it and a call that is marked every month, right or wrong." wide>
  <header class="research-head">
    <h1>Research</h1>
    <p>Initiation notes on the companies that build the physical layer of AI. Each comes with its Excel model, and every call is dated and marked monthly against its target. None is ever deleted.</p>
  </header>

  {pitches.length === 0 ? (
    <p class="scorecard-empty">The first notes are being written.</p>
  ) : (
    <>
      <ul class="stat-strip" aria-label="The book at a glance">
        <li><strong>{pitches.length}</strong> initiation notes</li>
        <li><strong>{longs}</strong> long</li>
        {shorts > 0 && <li><strong>{shorts}</strong> short</li>}
        <li><strong>{noCalls}</strong> no call</li>
        <li>Marked monthly{SCORECARD_REFRESHED ? <>, last on {fmtDate(new Date(SCORECARD_REFRESHED))}</> : ', from November 2026'}</li>
      </ul>

      <section class="track" id="scorecard" aria-labelledby="book-h">
        <h2 id="book-h">The calls</h2>
        <p class="track-intro">Each call against the closing price on the day it was published. Returns are signed so that a call going the right way is positive.</p>
        <div class="track-wrap">
          <table>
            <thead><tr><th>Company</th><th>Published</th><th>Call</th><th>Price then</th><th>Target</th><th>Latest</th><th>Return</th><th>Status</th><th>Files</th></tr></thead>
            <tbody>
              {rows.map(({ p, mark, ret, move, score }) => {
                const c = p.data.call;
                return (
                  <tr>
                    <td class="track-co"><a href={`/research/${p.id}/`}>{p.data.company}</a> <span>{p.data.ticker}</span></td>
                    <td>{p.data.date && fmtDate(p.data.date)}</td>
                    <td><span class={dirClass(p)}>{callLabel(p, false)}</span>{c.conviction && <span class="track-conv">, {c.conviction.toLowerCase()}</span>}</td>
                    <td>{fmtMoney(c.currency, c.price)}</td>
                    <td>{c.target != null ? fmtMoney(c.currency, c.target) : 'None'}</td>
                    <td>{mark ? fmtMoney(c.currency, mark.price) : 'Not yet marked'}</td>
                    <td class={ret == null ? '' : ret >= 0 ? 'up' : 'down'}>{ret != null ? fmtPct(ret) : move != null ? `n/a (price ${fmtPct(move)})` : 'n/a'}</td>
                    <td>{score?.resolved ? `${score.resolved.outcome}, ${fmtDate(new Date(score.resolved.date))}` : 'Open'}</td>
                    <td class="track-files"><a href={p.data.files.pdf}>Note</a> <a href={p.data.files.xlsx}>Model</a></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <section aria-labelledby="notes-h">
        <h2 class="research-sec-h" id="notes-h">The notes</h2>
        <ol class="library">
          {pitches.map((p) => {
            const d = p.data;
            const rests = restsOn(p);
            return (
              <li class="note-row">
                <p class="note-meta">
                  {d.date && <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>}
                  <span class={dirClass(p)}>{callLabel(p)}</span>
                </p>
                <div class="note-body">
                  <h3><a href={`/research/${p.id}/`}>{d.company} <span>{d.exchange}: {d.ticker}</span></a></h3>
                  <p class="note-title">{d.title}</p>
                  <p class="note-links">
                    <a href={d.files.pdf}>Note <small>PDF{d.files.pages && `, ${d.files.pages} pp`}</small></a>
                    <a href={d.files.xlsx}>Model <small>Excel</small></a>
                    {rests && <span class="note-rests">Rests on <a href={rests.href}>{rests.title}</a></span>}
                  </p>
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    </>
  )}

  <p class="research-foot">Each call rests on a claim made first in the journal. <a href="/claims/">See every claim and what would prove it wrong</a>. These notes are the author's own analysis, not investment advice. The author holds no position in any company covered unless a note says so.</p>
</Base>
