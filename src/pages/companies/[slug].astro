---
// Company pages were removed (Tommy, 6 Nov 2026). Every old company URL still
// resolves, to the homepage.
import { COMPANY_SLUGS } from '../../data/retired-urls';
export function getStaticPaths() {
  return COMPANY_SLUGS.map((slug) => ({ params: { slug } }));
}
return Astro.redirect('/', 301);
---
