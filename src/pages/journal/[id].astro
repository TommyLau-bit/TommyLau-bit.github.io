---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { SITE, OG_VERSION } from '../../config';
import { fmtDate, readingTime } from '../../utils';
import { claimOf, claimsHomedAt } from '../../data/claims';
import { getPitches, pitchesFor, callLabel } from '../../lib/calls';
import { layerOf } from '../../data/stack';
import { exposureOf, slugify, companyPages } from '../../lib/exposure';
export async function getStaticPaths() {
  const posts = await getCollection('journal', ({ data }) => !data.draft);
  const paged = companyPages(posts, (await getPitches()).map((n) => n.data.company)).map((c) => c.slug);
  return posts.map((p) => ({ params: { id: p.id }, props: { p, paged } }));
}
const { p, paged } = Astro.props;
const { Content, headings } = await render(p);
// Jump links into the investor layer of a deep piece: the ## headings below the
// <hr class="layer"> divider, so a reader can skip the plain-English top.
const body = p.body ?? '';
const cut = body.indexOf('<hr class="layer"');
const below = cut >= 0 ? body.slice(cut) : '';
const investorTo = cut >= 0 ? headings.filter((h) => h.depth === 2 && below.includes(`## ${h.text}`)) : [];
// An ordinary piece shows its one claim here. A deep piece that other claims
// have merged into shows none: its body carries the "Claims on record" block.
const isHome = claimsHomedAt(p.id).some((c) => c.home === p.id);
const claim = isHome ? undefined : claimOf(p.id);
const notes = pitchesFor(await getPitches(), p.id);
const layer = layerOf(p.id);
// only companies with a page of their own are linked (lib/exposure.ts, companyPages)
const companies = [...new Set(exposureOf(p).flatMap((r) => r.names))].filter((n) => paged.includes(slugify(n)));
---
<Base title={p.data.title} description={p.data.summary} type="article" canonical={`${SITE.url}/journal/${p.id}/`} image={`/og/${p.id}-${OG_VERSION}.png`}>
  <article>
    <header class="article-head">
      <h1>{p.data.title}</h1>
      <div class="meta">
        <span>{SITE.author}</span><span>·</span>
        <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
        <span>·</span><span>{readingTime(p.body ?? '')} min read</span>
        {p.data.tags.map((t) => <span class="tag">#{t}</span>)}
      </div>
      {p.data.updated && (
        <p class="updated">
          <strong>Updated {fmtDate(p.data.updated)}.</strong> {p.data.updateNote}
        </p>
      )}
      <aside class="plain">
        <p class="label">In plain English</p>
        <p>{p.data.summary}</p>
      </aside>
      {investorTo.length > 0 && (
        <nav class="investor-jump" aria-label="For investors">
          <span class="investor-jump-label">For investors</span>
          {investorTo.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
        </nav>
      )}
    </header>
    <div class="prose"><Content /></div>

    {claim && (
      <aside class="claim-box">
        <p class="claim-box-label">The claim this piece makes</p>
        <p class="claim-box-claim">{claim.claim}</p>
        <p class="claim-box-meta">
          <a href={`/claims/#${claim.id}`}>See it alongside every other claim on the site</a>
          {notes.map((n) => <a href={`/research/${n.id}/`}>Research note: {n.data.company}, {callLabel(n).toLowerCase()}</a>)}
        </p>
      </aside>
    )}

    {(layer || companies.length > 0) && (
      <nav class="related" aria-label="Related">
        {layer && (
          <p><span class="related-label">On the map</span> <a href={`/#${layer.id}`}>{layer.name}</a></p>
        )}
        {companies.length > 0 && (
          <p><span class="related-label">Companies named</span>
            {companies.map((n, i) => <>{i > 0 && ', '}<a href={`/companies/${slugify(n)}/`}>{n}</a></>)}
          </p>
        )}
      </nav>
    )}

    <footer class="article-foot">
      Unfamiliar term? The <a href="/glossary">glossary</a> explains every one of them in a line.<br />
      Written by {SITE.author}. If you think the argument is wrong, I would genuinely like to hear it: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
    </footer>
  </article>
</Base>
