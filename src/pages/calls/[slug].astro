---
// Pitches moved to /research/<slug>/ on 6 October 2026. Kept so early links work.
import { getPitches } from '../../lib/calls';
export async function getStaticPaths() {
  const pitches = await getPitches();
  return pitches.map((p) => ({ params: { slug: p.id } }));
}
const to = `/research/${Astro.params.slug}/`;
---
<meta http-equiv="refresh" content={`0; url=${to}`} />
<link rel="canonical" href={to} />
<a href={to}>This note has moved</a>
