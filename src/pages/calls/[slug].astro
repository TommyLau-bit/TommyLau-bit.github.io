---
// Pitches moved to /research/<slug>/ on 6 October 2026 and left the site on 6 Nov 2026. Kept so early links work.
import { NOTE_SLUGS } from '../../data/retired-urls';
export function getStaticPaths() {
  return NOTE_SLUGS.map((slug) => ({ params: { slug } }));
}
const to = '/';
---
<meta http-equiv="refresh" content={`0; url=${to}`} />
<link rel="canonical" href={to} />
<a href={to}>This note has moved</a>
