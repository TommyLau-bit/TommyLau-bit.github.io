---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { READING_PATH } from '../config';
import { readingTime } from '../utils';
const all = await getCollection('journal', ({ data }) => !data.draft);
const byId = Object.fromEntries(all.map((p) => [p.id, p]));
const stages = READING_PATH
  .map((s) => ({ ...s, posts: s.ids.map((id) => byId[id]).filter(Boolean) }))
  .filter((s) => s.posts.length);
const listed = new Set(stages.flatMap((s) => s.posts.map((p) => p.id)));
const rest = all
  .filter((p) => !listed.has(p.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
let n = 0;
const total = listed.size;
const mins = stages.flatMap((s) => s.posts).reduce((t, p) => t + readingTime(p.body ?? ''), 0);
---
<Base
  title="Start here"
  description="A short path through the physical constraints on the AI buildout, in the order that makes them make sense."
>
  <section class="hero hero--compact">
    <h1>Start here</h1>
    <p>
      Every piece stands on its own, but they build. This is the order that makes
      them make sense: what the building is doing, then the constraints working
      inward from the grid to the memory beside the chip.
    </p>
    <p class="hero-start">{total} pieces · about {mins} minutes end to end.</p>
  </section>

  <div class="path">
    {stages.map((s) => (
      <section class="path-stage">
        <h2>{s.stage}</h2>
        <p class="path-note">{s.note}</p>
        <ol class="path-list">
          {s.posts.map((p) => (
            <li>
              <span class="path-num">{String(++n).padStart(2, '0')}</span>
              <div>
                <a class="path-title" href={`/journal/${p.id}/`}>{p.data.title}</a>
                <p class="path-sum">{p.data.summary}</p>
                <span class="path-meta">{p.data.category} · {readingTime(p.body ?? '')} min</span>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}

    {rest.length > 0 && (
      <section class="path-stage">
        <h2>Also on the site</h2>
        <p class="path-note">Outside the main path, in no particular order.</p>
        <ol class="path-list path-list--plain">
          {rest.map((p) => (
            <li>
              <span class="path-num">·</span>
              <div>
                <a class="path-title" href={`/journal/${p.id}/`}>{p.data.title}</a>
                <p class="path-sum">{p.data.summary}</p>
                <span class="path-meta">{p.data.category} · {readingTime(p.body ?? '')} min</span>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>

  <p class="path-foot">
    Unsure about a word? The <a href="/glossary/">glossary</a> defines every term
    the journal uses, in plain English.
  </p>
</Base>
