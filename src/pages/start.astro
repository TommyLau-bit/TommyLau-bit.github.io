---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { READING_PATH, PATH_MAX, PATH_REVIEWED } from '../config';
import { readingTime } from '../utils';
const all = await getCollection('journal', ({ data }) => !data.draft);
const byId = Object.fromEntries(all.map((p) => [p.id, p]));
// Hard cap: the on-ramp stays this size no matter how much gets published.
const capped = new Set(READING_PATH.flatMap((s) => s.ids).slice(0, PATH_MAX));
const stages = READING_PATH
  .map((s) => ({ ...s, posts: s.ids.filter((id) => capped.has(id)).map((id) => byId[id]).filter(Boolean) }))
  .filter((s) => s.posts.length);
const chosen = stages.flatMap((s) => s.posts);
const mins = chosen.reduce((t, p) => t + readingTime(p.body ?? ''), 0);
let n = 0;
---
<Base
  title="Where to start"
  description="A handful of pieces, in the order that makes the physical constraints on the AI buildout stack up the way they actually do."
>
  <section class="hero hero--compact">
    <h1>Where to start</h1>
    <p>
      Every piece stands on its own, but these build on each other. Read them in
      this order and the constraints stack up the way they actually do, working
      inward from the grid connection to the memory sitting beside the chip.
    </p>
    <p class="hero-start">
      {chosen.length} pieces · about {mins} minutes. A fixed on-ramp, not an
      index of the site. Chosen {PATH_REVIEWED}.
    </p>
  </section>

  <div class="path">
    {stages.map((s) => (
      <section class="path-stage">
        <h2>{s.stage}</h2>
        <p class="path-note">{s.note}</p>
        <ol class="path-list">
          {s.posts.map((p) => (
            <li>
              <span class="path-num">{String(++n).padStart(2, '0')}</span>
              <div>
                <a class="path-title" href={`/journal/${p.id}/`}>{p.data.title}</a>
                <p class="path-sum">{p.data.summary}</p>
                <span class="path-meta">{p.data.category} · {readingTime(p.body ?? '')} min</span>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <p class="path-foot">
    That is the whole on-ramp. Everything else, and everything published since,
    is in <a href="/">the journal</a>, newest first. If a word gets in the way,
    the <a href="/glossary/">glossary</a> defines every term in plain English.
  </p>
</Base>
